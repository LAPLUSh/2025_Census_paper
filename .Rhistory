#Now let's clean the parent language use question names
census_clean <- census_clean %>%
rename(c1_english_percent =what_percentage_of_time_do_you_speak_each_of_the_following_languages_to_your_child_english,
c1_french_percent =what_percentage_of_time_do_you_speak_each_of_the_following_languages_to_your_child_french,
