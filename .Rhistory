# 3. PREPARE LANGUAGE-LEVEL THRESHOLD DATA
# ============================================================
threshold_plot_data <- model_data_long %>%
left_join(
language_groups %>%
select(internal_id, language_group),
by = "internal_id",
relationship = "many-to-one"
) %>%
mutate(
language_type = factor(
as.character(language_type),
levels = c("Community", "Heritage")
),
below_activeness = case_when(
is.na(active_use) ~ NA_integer_,
active_use < ACTIVE_THRESHOLD ~ 1L,
TRUE ~ 0L
),
below_matching = case_when(
is.na(interlocutor_matching) ~ NA_integer_,
interlocutor_matching < MATCHING_THRESHOLD ~ 1L,
TRUE ~ 0L
)
) %>%
filter(
language_group %in% c(
"Community–Heritage bilinguals",
"Trilinguals+"
)
) %>%
droplevels()
# ============================================================
# 4. SUMMARIZE PERCENTAGES BELOW THRESHOLD
# ============================================================
activeness_summary <- threshold_plot_data %>%
filter(!is.na(below_activeness)) %>%
group_by(language_group, language_type) %>%
summarise(
n_languages = n(),
n_below = sum(below_activeness),
percent_below = 100 * mean(below_activeness),
.groups = "drop"
) %>%
mutate(outcome_metric = "Active language use")
matching_summary <- threshold_plot_data %>%
filter(!is.na(below_matching)) %>%
group_by(language_group, language_type) %>%
summarise(
n_languages = n(),
n_below = sum(below_matching),
percent_below = 100 * mean(below_matching),
.groups = "drop"
) %>%
mutate(outcome_metric = "Interlocutor matching")
threshold_summary <- bind_rows(
activeness_summary,
matching_summary
) %>%
mutate(
outcome_metric = factor(
outcome_metric,
levels = c(
"Active language use",
"Interlocutor matching"
)
),
language_group = factor(
language_group,
levels = c(
"Community–Heritage bilinguals",
"Trilinguals+"
)
)
)
print(threshold_summary)
# ============================================================
# 5. FIGURE: LANGUAGES BELOW THRESHOLD
# ============================================================
threshold_figure <- ggplot(
threshold_summary,
aes(
x = language_type,
y = percent_below,
fill = language_type
)
) +
geom_col(width = 0.6) +
geom_text(
aes(label = paste0(round(percent_below, 1), "%")),
vjust = -0.4,
size = 4.3
) +
facet_grid(
outcome_metric ~ language_group
) +
scale_fill_manual(
values = c(
"Community" = "#8DAEE1",
"Heritage" = "#B0DA87"
),
drop = FALSE
) +
scale_y_continuous(
limits = c(0, 110),
breaks = seq(0, 100, 20),
labels = function(x) paste0(x, "%")
) +
labs(
x = NULL,
y = "Languages below threshold (%)",
fill = "Language type",
title = "Language status and below-threshold outcomes"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "bottom",
strip.text = element_text(
size = 13,
face = "bold"
),
axis.text.x = element_text(size = 12)
)
print(threshold_figure)
ggsave(
"Figure_below_threshold_by_status_and_outcome.pdf",
threshold_figure,
width = 8.5,
height = 7,
bg = "white"
)
# ============================================================
# 6. PREPARE LONG DATA FOR STATISTICAL TESTS
# ============================================================
threshold_test_data <- threshold_plot_data %>%
select(
internal_id,
language,
language_group,
language_type,
below_activeness,
below_matching
) %>%
pivot_longer(
cols = c(below_activeness, below_matching),
names_to = "outcome_metric",
values_to = "below_threshold"
) %>%
mutate(
outcome_metric = dplyr::recode(
outcome_metric,
below_activeness = "Active language use",
below_matching = "Interlocutor matching"
),
below_threshold = as.integer(below_threshold)
) %>%
filter(!is.na(below_threshold)) %>%
droplevels()
# Check that no child-language-outcome is duplicated
duplicates <- threshold_test_data %>%
count(internal_id, language, outcome_metric) %>%
filter(n > 1)
stopifnot(nrow(duplicates) == 0)
# Verify threshold coding
stopifnot(
all(
threshold_plot_data$below_activeness[
!is.na(threshold_plot_data$active_use)
] ==
as.integer(
threshold_plot_data$active_use[
!is.na(threshold_plot_data$active_use)
] < ACTIVE_THRESHOLD
)
),
all(
threshold_plot_data$below_matching[
!is.na(threshold_plot_data$interlocutor_matching)
] ==
as.integer(
threshold_plot_data$interlocutor_matching[
!is.na(threshold_plot_data$interlocutor_matching)
] < MATCHING_THRESHOLD
)
)
)
# ============================================================
# 7. VERIFY FIGURE AND TEST DATA AGREE
# ============================================================
summary_from_tests <- threshold_test_data %>%
group_by(
outcome_metric,
language_group,
language_type
) %>%
summarise(
n_languages_check = n(),
n_below_check = sum(below_threshold),
.groups = "drop"
)
figure_check <- threshold_summary %>%
left_join(
summary_from_tests,
by = c(
"outcome_metric",
"language_group",
"language_type"
)
) %>%
filter(
is.na(n_languages_check) |
n_languages != n_languages_check |
n_below != n_below_check
)
stopifnot(nrow(figure_check) == 0)
cat("\nFigure and statistical test data agree.\n")
# ============================================================
# 8. COMMUNITY-HERITAGE BILINGUALS
# EXACT PAIRED MCNEMAR TESTS
# ============================================================
bilingual_data <- threshold_test_data %>%
filter(
language_group == "Community–Heritage bilinguals"
)
# One observation per child, type, and outcome
bilingual_duplicates <- bilingual_data %>%
count(
internal_id,
outcome_metric,
language_type
) %>%
filter(n > 1)
stopifnot(nrow(bilingual_duplicates) == 0)
# Create one row per child per outcome
bilingual_paired <- bilingual_data %>%
select(
internal_id,
outcome_metric,
language_type,
below_threshold
) %>%
pivot_wider(
names_from = language_type,
values_from = below_threshold
) %>%
filter(
!is.na(Community),
!is.na(Heritage)
)
# Check paired sample sizes
print(
bilingual_paired %>%
count(outcome_metric, name = "N_paired_children")
)
# ------------------------------------------------------------
# Exact paired comparison function
# ------------------------------------------------------------
run_paired_test <- function(data, outcome_name) {
dat <- data %>%
filter(outcome_metric == outcome_name)
paired_table <- table(
Community = factor(dat$Community, levels = c(0, 1)),
Heritage = factor(dat$Heritage, levels = c(0, 1))
)
cat("\n====================================\n")
cat("PAIRED TEST:", outcome_name, "\n")
cat("====================================\n")
print(paired_table)
# Heritage below, Community above
b <- sum(
dat$Community == 0 &
dat$Heritage == 1
)
# Community below, Heritage above
c <- sum(
dat$Community == 1 &
dat$Heritage == 0
)
if (b + c > 0) {
result <- binom.test(
x = b,
n = b + c,
p = 0.5
)
p_value <- result$p.value
} else {
p_value <- 1
}
tibble(
Outcome = outcome_name,
N_children = nrow(dat),
Heritage_below_Community_above = b,
Community_below_Heritage_above = c,
Discordant_pairs = b + c,
p_value = p_value
)
}
bilingual_results <- purrr::map_dfr(
c("Active language use", "Interlocutor matching"),
~ run_paired_test(bilingual_paired, .x)
)
print(bilingual_results)
# ============================================================
# 9. TRILINGUALS+
# BINOMIAL MIXED-EFFECTS MODELS
# ============================================================
trilingual_data <- threshold_test_data %>%
filter(language_group == "Trilinguals+") %>%
droplevels()
# Descriptive checks
trilingual_summary <- trilingual_data %>%
group_by(outcome_metric, language_type) %>%
summarise(
N_languages = n(),
N_children = n_distinct(internal_id),
N_below = sum(below_threshold),
Percent_below = 100 * mean(below_threshold),
.groups = "drop"
)
print(trilingual_summary)
# ------------------------------------------------------------
# Function: GLMM by outcome
# ------------------------------------------------------------
run_trilingual_model <- function(data, outcome_name) {
dat <- data %>%
filter(outcome_metric == outcome_name) %>%
droplevels()
cat("\n====================================\n")
cat("TRILINGUAL MODEL:", outcome_name, "\n")
cat("====================================\n")
cat("Observations:", nrow(dat), "\n")
cat("Children:", n_distinct(dat$internal_id), "\n")
null_model <- glmer(
below_threshold ~ 1 + (1 | internal_id),
data = dat,
family = binomial,
control = glmerControl(optimizer = "bobyqa")
)
language_model <- glmer(
below_threshold ~ language_type + (1 | internal_id),
data = dat,
family = binomial,
control = glmerControl(optimizer = "bobyqa")
)
comparison <- anova(
null_model,
language_model,
test = "Chisq"
)
odds_ratios <- broom.mixed::tidy(
language_model,
effects = "fixed",
conf.int = TRUE,
conf.method = "Wald",
exponentiate = TRUE
)
singular <- lme4::isSingular(language_model)
convergence_messages <-
language_model@optinfo$conv$lme4$messages
cat("\nMODEL COMPARISON\n")
print(comparison)
cat("\nMODEL COEFFICIENTS\n")
print(summary(language_model))
cat("\nODDS RATIOS\n")
print(odds_ratios)
cat("\nMODEL DIAGNOSTICS\n")
cat("Singular:", singular, "\n")
if (length(convergence_messages) > 0) {
print(convergence_messages)
} else {
cat("No convergence warnings.\n")
}
print(VarCorr(language_model))
list(
null_model = null_model,
language_model = language_model,
comparison = comparison,
odds_ratios = odds_ratios,
singular = singular,
convergence_messages = convergence_messages
)
}
# ============================================================
# 10. RUN TRILINGUAL MODELS
# ============================================================
trilingual_active <- run_trilingual_model(
trilingual_data,
"Active language use"
)
trilingual_matching <- run_trilingual_model(
trilingual_data,
"Interlocutor matching"
)
# ============================================================
# 11. EXTRACT RESULTS FOR REPORTING
# ============================================================
trilingual_results <- bind_rows(
trilingual_active$odds_ratios %>%
mutate(Outcome = "Active language use"),
trilingual_matching$odds_ratios %>%
mutate(Outcome = "Interlocutor matching")
) %>%
filter(term == "language_typeHeritage") %>%
select(
Outcome,
term,
estimate,
conf.low,
conf.high,
p.value
)
cat("\n====================================\n")
cat("FINAL PAIRED COMPARISONS\n")
cat("====================================\n")
print(bilingual_results)
cat("\n====================================\n")
cat("FINAL TRILINGUAL ODDS RATIOS\n")
cat("====================================\n")
print(trilingual_results)
# ============================================================
# 12. FINAL AUDIT CHECKS
# ============================================================
# Confirm groups agree with the source classification
classification_check <- threshold_plot_data %>%
distinct(internal_id, language_group) %>%
left_join(
language_groups %>%
select(
internal_id,
current_group = language_group
),
by = "internal_id"
) %>%
filter(
as.character(language_group) !=
as.character(current_group) |
is.na(current_group)
)
stopifnot(nrow(classification_check) == 0)
# Confirm number of children and observations
final_sample_check <- threshold_test_data %>%
group_by(outcome_metric, language_group) %>%
summarise(
N_children = n_distinct(internal_id),
N_languages = n(),
.groups = "drop"
)
print(final_sample_check)
cat("\n====================================\n")
cat("EXPLORATORY ANALYSIS AUDIT COMPLETED\n")
cat("====================================\n")
cat("No duplicate child-language-outcome rows.\n")
cat("Language classifications are consistent.\n")
cat("Figure and statistical test summaries agree.\n")
cat("Check GLMM singularity and warnings above.\n")
bilingual_results
trilingual_results
# ============================================================
# SENSITIVITY: Singular trilingual active-use GLMM
# Logistic regression with child-cluster-robust SEs
# ============================================================
library(dplyr)
library(sandwich)
install.packages("sandwich")
# ============================================================
# SENSITIVITY: Singular trilingual active-use GLMM
# Logistic regression with child-cluster-robust SEs
# ============================================================
library(dplyr)
library(sandwich)
library(lmtest)
tri_active_data <- trilingual_data %>%
filter(outcome_metric == "Active language use") %>%
droplevels()
# Fit ordinary logistic regression
tri_active_glm <- glm(
below_threshold ~ language_type,
data = tri_active_data,
family = binomial
)
# Cluster-robust covariance matrix
cluster_vcov <- sandwich::vcovCL(
tri_active_glm,
cluster = tri_active_data$internal_id,
type = "HC1"
)
# Cluster-robust coefficient tests
lmtest::coeftest(
tri_active_glm,
vcov. = cluster_vcov,
df = n_distinct(tri_active_data$internal_id) - 1
)
# Odds ratio and cluster-robust 95% CI
estimate <- coef(tri_active_glm)["language_typeHeritage"]
robust_se <- sqrt(
diag(cluster_vcov)
)["language_typeHeritage"]
critical_value <- qt(
0.975,
df = n_distinct(tri_active_data$internal_id) - 1
)
data.frame(
predictor = "Heritage vs Community",
OR = exp(estimate),
CI_lower = exp(
estimate - critical_value * robust_se
),
CI_upper = exp(
estimate + critical_value * robust_se
)
)
anova(matching_societal, matching_both_layers)
