multiple_language_responses / total_language_responses
)
# 5. Match the StatCan multilingualism estimates to our Quebec
#    Census Division lookup table
# ------------------------------------------------------------
#
# GeoUID in the cansim table corresponds to geo_uid from cancensus.
#
# Joining by the geographic ID is preferable to joining by region name,
# because IDs are stable and avoid problems caused by accents,
# punctuation, spelling differences, or formatting.
cd_multilingual_rate <- qc_geo_cd %>%
left_join(
qc_cd_multilingual_rate %>%
transmute(
geo_uid = as.character(GeoUID),
multilingual_rate
),
by = "geo_uid"
)
# 6. Merge the regional multilingualism rate into the survey data
# ---------------------------------------------------------------
#
# Each survey participant already has a census_subdivision variable.
# We therefore attach the Census Division-level multilingualism rate
# by matching participants to their Census Division.
#
# All participants living in the same Census Division receive the same
# regional multilingualism-rate value.
clean_w_predictors <- clean_w_predictors %>%
left_join(
cd_multilingual_rate,
by = "census_subdivision"
)
# ============================================================
# Create regional speaker rates for languages heard by children
# using 2021 Census "Knowledge of languages" data
# ============================================================
# 1. Put children's languages into long format
# ---------------------------------------------
languages_heard <- clean_w_predictors %>%
dplyr::select(
internal_id,
census_subdivision,
child_english,
child_french,
child_first_minority,
child_second_minority,
child_third_minority,
geo_uid
) %>%
pivot_longer(
cols = child_english:child_third_minority,
names_to = "language_type",
values_to = "language"
) %>%
mutate(
language = case_when(
language == "Anglais" ~ "English",
language == "Francais" ~ "French",
language == "francais" ~ "French",
language == "Berbère" ~ "Berber",
language == "Portugais" ~ "Portuguese",
language == "Allemand" ~ "German",
language == "allemand" ~ "German",
language == "italien" ~ "Italian",
language == "Suisse-Allemand" ~ "German",
language == "Espagnol" ~ "Spanish",
language == "espagnol" ~ "Spanish",
language == "hungarian" ~ "Hungarian",
language == "Polonais" ~ "Polish",
language == "polonais" ~ "Polish",
language == "Spanish and German" ~ "German",
language == "francaus et arabe" ~ "Arabic",
language == "Bosnian (Serbian, Croatian)" ~ "Bosnian",
language == "Grec" ~ "Greek",
language == "Créole Reunionnais" ~ "Creole languages, n.i.e.",
language == "Créole reunionnais" ~ "Creole languages, n.i.e.",
language == "Créole réunionnais" ~ "Creole languages, n.i.e.",
language == "créole haïtien" ~ "Hatian Creole",
language == "le lingala" ~ "Lingala",
language == "Italien" ~ "Italian",
language == "Lsq" ~ "QSL",
language == "LSQ" ~ "QSL",
language == "Arménien" ~ "Armenian",
language == "Malgache" ~ "Malagasy",
language == "Cri" ~ "Cree",
language == "Russe" ~ "Russian",
language == "Arabe" ~ "Arabic",
language == "Mooré"~ "Moore",
language == "Moore" ~ "Niger-Congo languages, n.i.e.",
language == "Banen" ~ "Niger-Congo languages, n.i.e.",
language == "Non"~ NA,
TRUE ~ language
)
)
# Create a list of the unique languages represented in the survey.
# This is useful for checking whether our survey labels match the
# Statistics Canada language labels.
survey_languages <- languages_heard %>%
distinct(language) %>%
filter(!is.na(language)) %>%
arrange(language)
# ============================================================
# Retrieve 2021 Census "Knowledge of languages" vectors
# ============================================================
ca21_vectors <- list_census_vectors("CA21")
# v_CA21_3229 is the parent vector for:
# "Knowledge of languages for the population in private households"
#
# This is based on the 2021 Census 25% sample data and contains
# both official and non-official languages.
knowledge_language_children <- child_census_vectors(
"v_CA21_3229",
leaves_only = TRUE
)
# Keep only the individual language vectors.
#
# Using leaves_only = TRUE removes broad aggregate categories such as
# "Official languages", "Non-official languages", "Indigenous languages",
# etc., leaving the most specific language categories available.
language_lookup <- knowledge_language_children %>%
select(
vector,
census_language = label
)
#to avoid breaking the r memory by querying too many languages at once, I will break up the query into batches
language_vectors <- language_lookup$vector
# ============================================================
# Download the language counts for Quebec Census Divisions
# ============================================================
#
# The Census contains many language vectors, so the vectors are split
# into batches of 50 to avoid making a very large query at once.
language_vectors <- language_lookup$vector
vector_batches <- split(
language_vectors,
ceiling(seq_along(language_vectors) / 50)
)
language_batches <- lapply(
vector_batches,
function(x) {
get_census(
dataset = "CA21",
regions = list(PR = "24"),
level = "CD",
vectors = x,
labels = "short"
)
}
)
# Start with the first batch.
qc_cd_languages_wide <- language_batches[[1]]
# Add the remaining batches by matching Census Divisions on GeoUID.
if (length(language_batches) > 1) {
for (i in 2:length(language_batches)) {
new_cols <- setdiff(
names(language_batches[[i]]),
names(qc_cd_languages_wide)
)
qc_cd_languages_wide <- qc_cd_languages_wide %>%
left_join(
language_batches[[i]] %>%
select(GeoUID, all_of(new_cols)),
by = "GeoUID"
)
}
}
census_language_cd <- qc_cd_languages_wide %>%
pivot_longer(
cols = starts_with("v_CA21_"),
names_to = "vector",
values_to = "language_knowledge_n"
)
census_language_cd <- census_language_cd %>%
left_join(
language_lookup,
by = "vector"
)
# ============================================================
# Retrieve denominator for language knowledge rates
# ============================================================
#
# v_CA21_3229 represents the population in private households
# covered by the Census "Knowledge of languages" measure.
#
# Using this as the denominator ensures that the language-specific
# counts and the population denominator come from the same Census
# concept and statistical universe.
cd_population_knowledge <- get_census(
dataset = "CA21",
regions = list(PR = "24"),
level = "CD",
vectors = "v_CA21_3229",
labels = "short"
)
cd_population_knowledge <- cd_population_knowledge %>%
select(
GeoUID,
knowledge_language_population = v_CA21_3229
)
# ============================================================
# Calculate regional prevalence of knowledge of each language
# ============================================================
census_language_cd <- census_language_cd %>%
left_join(
cd_population_knowledge,
by = "GeoUID"
) %>%
mutate(
language_knowledge_rate =
language_knowledge_n / knowledge_language_population,
language_knowledge_percent =
language_knowledge_rate * 100
)
#Check language matches
language_crosswalk <- languages_heard %>%
distinct(language) %>%
filter(!is.na(language)) %>%
rename(survey_language = language) %>%
mutate(
census_language = case_when(
survey_language == "Berber" ~ "Berber languages, n.i.e.",
survey_language == "Persian" ~ "Persian (Farsi), n.o.s.",
survey_language == "Punjabi" ~ "Punjabi (Panjabi)",
survey_language == "Malagasy" ~ "Malagasy, n.o.s.",
survey_language == "QSL" ~ "Quebec Sign Language",
survey_language == "Cree" ~ "Cree, n.o.s.",
TRUE ~ survey_language
),
exact_match =
census_language %in% language_lookup$census_language
)
finding_mismatches<- language_crosswalk %>%
filter(!exact_match)
#final joins
census_lookup_final <- language_crosswalk %>%
select(
survey_language,
census_language
) %>%
left_join(
census_language_cd,
by = "census_language"
)
data_clean_long <- languages_heard %>%
left_join(
census_lookup_final %>%
select(
survey_language,
GeoUID,
language_knowledge_n,
knowledge_language_population,
language_knowledge_rate,
language_knowledge_percent
),
by = c(
"language" = "survey_language",
"geo_uid" = "GeoUID"
)
)
data_clean_long<- data_clean_long %>%
select(-language_type)
#Join this to our data frame to have all the predictors in place
long_with_predictors<- clean_w_predictors %>%
left_join(data_clean_long, by=c("internal_id", "census_subdivision", "geo_uid"))
#pearson correlation matrix including age, multingual rate, active use (both), attitudes, concerns.
#For the matrix at least run each concern and attitude separate.
for_correlation <- clean_w_predictors %>%
select(child_age_years, beleifs_ahead_in_life, beleifs_belonging, beliefs_cognitive_benefits, worry_master_languages, worry_cognitive_difficulties, worry_school_difficulties, child_french_active_use_category, child_english_active_use_category, child_first_min_active_use_category, child_second_min_active_use_category, child_third_min_active_use_category, child_french_interlocutor_matching, child_english_interlocutor_matching, child_first_min_interlocutor_matching, child_second_min_interlocutor_matching, child_third_min_interlocutor_matching, multilingual_rate)
#making an average categorical active use measure for the language agnostic analyses
for_correlation<- for_correlation %>%
mutate(
child_active_use_mean = rowMeans(
across(
c(
child_french_active_use_category,
child_english_active_use_category,
child_first_min_active_use_category,
child_second_min_active_use_category,
child_third_min_active_use_category
)
),
na.rm = TRUE
),
child_active_use_mean = ifelse(
is.nan(child_active_use_mean),
NA_real_,
child_active_use_mean
)
)
#making an average continuous active use measure for the language agnostic analyses
for_correlation<- for_correlation %>%
mutate(
child_interlocutor_matching_mean = rowMeans(
across(
c(child_french_interlocutor_matching,
child_english_interlocutor_matching,
child_first_min_interlocutor_matching,
child_second_min_interlocutor_matching,
child_third_min_interlocutor_matching
)
),
na.rm = TRUE
),
child_interlocutor_matching_mean = ifelse(
is.nan(child_interlocutor_matching_mean),
NA_real_,
child_interlocutor_matching_mean
)
)
for_correlation <- for_correlation %>%
select(-child_french_active_use_category, -child_english_active_use_category, -child_first_min_active_use_category, -child_second_min_active_use_category, -child_third_min_active_use_category, -child_french_interlocutor_matching, -child_english_interlocutor_matching, -child_first_min_interlocutor_matching, -child_second_min_interlocutor_matching, -child_third_min_interlocutor_matching)
for_correlation <- for_correlation %>%
mutate(across(everything(), as.numeric))
language_agnostic_correlation <- cor(
for_correlation,
use = "pairwise.complete.obs",
method = "pearson"
)
corrplot(
language_agnostic_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
#Base model categories
base_category<- lm(child_active_use_mean~ multilingual_rate + child_age_years, data= for_correlation )
summary(base_category)
#Beliefs categorical models
cat_beleifs_model_1<- lm(child_active_use_mean~ multilingual_rate + child_age_years + beliefs_cognitive_benefits, data= for_correlation)
cat_beleifs_model_2<- lm(child_active_use_mean~ multilingual_rate + child_age_years + beliefs_cognitive_benefits + beleifs_ahead_in_life, data= for_correlation)
cat_beleifs_model_3<- lm(child_active_use_mean~ multilingual_rate + child_age_years + beliefs_cognitive_benefits + beleifs_ahead_in_life + beleifs_belonging, data= for_correlation)
#worries categorical models
cat_worries_model_1<- lm(child_active_use_mean~ multilingual_rate + child_age_years + worry_master_languages, data= for_correlation)
cat_worries_model_2<- lm(child_active_use_mean~ multilingual_rate + child_age_years + worry_master_languages + concern_cognitive_difficulties, data= for_correlation)
for_correlation_long<- long_with_predictors %>%
select(internal_id, child_age_years,language, language_knowledge_rate, overall_exposure_english_child, overall_exposure_french_child, book_resources_english, book_resources_french, caregiver_english_book_reading, caregiver_french_book_reading, beleifs_ahead_in_life, beleifs_belonging, beliefs_cognitive_benefits, worry_master_languages, worry_cognitive_difficulties, worry_school_difficulties, child_french_active_use_category, child_english_active_use_category, child_french_interlocutor_matching, child_english_interlocutor_matching)
#building a separate matrix for French, English and minority languages
english_cor_data <- for_correlation_long %>%
filter(language == "English") %>%
distinct(internal_id, .keep_all = TRUE) %>%
select(child_age_years, beleifs_ahead_in_life, beleifs_belonging, beliefs_cognitive_benefits, worry_master_languages, worry_cognitive_difficulties, worry_school_difficulties,
child_english_active_use_category,
language_knowledge_rate,
overall_exposure_english_child,
book_resources_english,
caregiver_english_book_reading,
child_english_interlocutor_matching
)
english_cor_data <- english_cor_data %>%
mutate(across(everything(), as.numeric))
english_correlation <- cor(
english_cor_data,
use = "pairwise.complete.obs",
method = "spearman"
)
corrplot(
english_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
french_cor_data <- for_correlation_long %>%
filter(language == "French") %>%
distinct(internal_id, .keep_all = TRUE) %>%
select(child_age_years, beleifs_ahead_in_life, beleifs_belonging, beliefs_cognitive_benefits, worry_master_languages, worry_cognitive_difficulties, worry_school_difficulties,
child_french_active_use_category,
language_knowledge_rate,
overall_exposure_french_child,
book_resources_french,
caregiver_french_book_reading,
child_french_interlocutor_matching
)
french_cor_data <- french_cor_data %>%
mutate(across(everything(), as.numeric))
french_correlation <- cor(
french_cor_data,
use = "pairwise.complete.obs",
method = "spearman"
)
corrplot(
french_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
#Minority Matrix
minority_long <- clean_w_predictors %>%
# First standardize all first/second/third variables
rename(
# Language name
minority_language_first = child_first_minority,
minority_language_second = child_second_minority,
minority_language_third = child_third_minority,
# Exposure
minority_overall_exposure_first = overall_exposure_first_min_child,
minority_overall_exposure_second = overall_exposure_second_min_child,
minority_overall_exposure_third = overall_exposure_third_min_child,
# Book resources
minority_book_resources_first = book_resources_first_minority,
minority_book_resources_second = book_resources_second_minority,
minority_book_resources_third = book_resources_third_minority,
# Book reading
minority_book_reading_first = caregiver_first_min_book_reading,
minority_book_reading_second = caregiver_second_min_book_reading,
minority_book_reading_third = caregiver_third_min_book_reading,
# Active use
minority_active_use_first = child_first_min_active_use_category,
minority_active_use_second = child_second_min_active_use_category,
minority_active_use_third = child_third_min_active_use_category,
# Interlocutor matching
minority_interlocutor_matching_first =
child_first_min_interlocutor_matching,
minority_interlocutor_matching_second =
child_second_min_interlocutor_matching,
minority_interlocutor_matching_third =
child_third_min_interlocutor_matching
) %>%
# Turn first/second/third into rows
pivot_longer(
cols = matches(
"^minority_(language|overall_exposure|book_resources|book_reading|active_use|interlocutor_matching)_(first|second|third)$"
),
names_to = c(".value", "minority_order"),
names_pattern = "(.+)_(first|second|third)$"
) %>%
# Clean the actual language name
mutate(
minority_language = case_when(
minority_language == "Anglais" ~ "English",
minority_language == "Francais" ~ "French",
minority_language == "Berbère" ~ "Berber",
minority_language == "Portugais" ~ "Portuguese",
minority_language == "Allemand" ~ "German",
minority_language == "allemand" ~ "German",
minority_language == "Suisse-Allemand" ~ "German",
minority_language == "Espagnol" ~ "Spanish",
minority_language == "espagnol" ~ "Spanish",
minority_language == "hungarian" ~ "Hungarian",
minority_language == "Polonais" ~ "Polish",
minority_language == "polonais" ~ "Polish",
minority_language == "Spanish and German" ~ "German",
minority_language == "francaus et arabe" ~ "Arabic",
minority_language == "Bosnian (Serbian, Croatian)" ~ "Bosnian",
minority_language == "Grec" ~ "Greek",
minority_language == "Créole Reunionnais" ~ "Creole",
minority_language == "Créole reunionnais" ~ "Creole",
minority_language == "Italien" ~ "Italian",
minority_language == "Lsq" ~ "QSL",
minority_language == "LSQ" ~ "QSL",
minority_language == "Arménien" ~ "Armenian",
minority_language == "Malgache" ~ "Malagasy",
minority_language == "Cri" ~ "Cree",
TRUE ~ minority_language
)
) %>%
# Children without a language in this position don't need a row
filter(!is.na(minority_language))
language_rates <- data_clean_long %>%
select(
internal_id,
census_subdivision,
geo_uid,
language,
language_knowledge_rate
) %>%
distinct()
minority_cor_data <- minority_long %>%
left_join(
language_rates,
by = c(
"internal_id",
"census_subdivision",
"geo_uid",
"minority_language" = "language"
)
)
#Just check the participant with creole, that is the only NA that does not come from that language not existing in that census division
minority_cor_data_matrix <- minority_cor_data %>%
select(child_age_years, beleifs_ahead_in_life, beleifs_belonging, beliefs_cognitive_benefits, worry_master_languages, worry_cognitive_difficulties, worry_school_difficulties,
minority_active_use,
language_knowledge_rate,
minority_overall_exposure,
minority_book_resources,
minority_book_reading,
minority_interlocutor_matching
)
minority_cor_data_matrix <- minority_cor_data_matrix %>%
mutate(across(everything(), as.numeric))
minority_correlation <- cor(
minority_cor_data_matrix,
use = "pairwise.complete.obs",
method = "spearman"
)
corrplot(
minority_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
#Matrix with English active use (both), French, Minority. Age, exposure per language, density of speaker per language, and multilingualism rate, attitudes, and concerns (one row each).
#active use by language ~ age + language exposure + speaker rate (one set of models)
#active use by language ~ age + language exposure + speaker rate + multilingualism rate (exploratory to see if adding the multilingualism rate soaks up more variance)
