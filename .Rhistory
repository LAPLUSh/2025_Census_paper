#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Now let's get dates into the correct format and calculate age
census_clean$submitted_date<- as.Date(census_clean$submitted_date)
census_clean$dob <- as.Date(census_clean$dob)
census_clean$child_age_years <- time_length(
interval(census_clean$dob, census_clean$submitted_date),
unit = "years"
) |> floor()
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Let's select the variables we are going to use for the analyses in this manuscript. Build a base data frame into which to add the wrangled predictors
df_base<- census_clean %>%
select(internal_id, status, child_age_years, child_gender, other_caregiver, child_speaks_minority_languages, vision_hearing_delays, school_daycare_attendance, school_language, daycare_language,school_min_language,daycare_min_language, where_do_you_live, child_english, c1_english_percent, c2_english_percent, child_french, c1_french_percent, c2_french_percent, first_minority_language, c1_first_minority_percent, c2_first_minority_percent, second_minority_language,c1_second_minority_percent, c2_second_minority_percent, third_minority_language, c1_third_minority_percent, c2_third_minority_percent) %>%
filter(status == "Submitted", vision_hearing_delays !="Yes"|is.na(vision_hearing_delays))
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Now let's wrangle and add # of language sources for each language
df_base_sources <- df_base %>%
#Identifying which caregivers speak the minority language
mutate(english_c_sources = case_when(c1_english_percent >=25 & c2_english_percent>=25 ~ 2,
c1_english_percent>=25| c2_english_percent>=25 ~ 1,
TRUE~ 0),
french_c_sources = case_when(c1_french_percent >=25 & c2_french_percent>=25 ~ 2,
c1_french_percent>=25| c2_french_percent>=25 ~ 1,
TRUE~ 0),
first_min_c_sources = case_when(c1_first_minority_percent >=25 & c2_first_minority_percent>=25 ~ 2,
c1_first_minority_percent>=25| c2_first_minority_percent>=25 ~ 1,
TRUE~ 0),
second_min_c_sources = case_when(c1_second_minority_percent >=25 & c2_second_minority_percent>=25 ~ 2,
c1_second_minority_percent>=25| c2_second_minority_percent>=25 ~ 1,
TRUE~ 0),
third_min_c_sources = case_when(c1_third_minority_percent >=25 & c2_third_minority_percent>=25 ~ 2,
c1_third_minority_percent>=25| c2_third_minority_percent>=25 ~ 1,
TRUE~ 0)
) %>%
mutate(english_s_sources = case_when(str_detect(tolower(school_language), "english") ~ 1,
TRUE~ 0),
french_s_sources = case_when(str_detect(tolower(school_language), "french") ~ 1,
TRUE~ 0),
first_min_s_sources = if_else(school_min_language == first_minority_language |
daycare_min_language == first_minority_language,
1, 0, missing = 0),
second_min_s_sources = if_else(school_min_language == second_minority_language |
daycare_min_language == second_minority_language,
1, 0, missing = 0),
third_min_s_sources = if_else(school_min_language == third_minority_language |
daycare_min_language == third_minority_language,
1, 0, missing = 0),
) %>%
mutate(overall_eng_sources = english_c_sources +english_s_sources,
overall_fre_sources = french_c_sources + french_s_sources,
overall_first_min_sources = first_min_c_sources + first_min_s_sources,
overall_second_min_sources = second_min_c_sources +second_min_s_sources,
overall_third_min_sources = third_min_c_sources +third_min_s_sources)
df_base_census<- df_base_sources %>%
select(internal_id, where_do_you_live)
#First for csd
qc_geo <- get_census(
dataset = "CA21",
regions = list(PR = "24"),
level = "CSD",
vectors = "v_CA21_1"   # dummy vector just to retrieve geographies
) %>%
clean_names() %>%
distinct(geo_uid, region_name)
qc_geo <- qc_geo  %>%
mutate(
place_clean = str_remove(region_name, "[(]")
)
unique(qc_geo$place_clean)
qc_geo <- qc_geo  %>%
mutate(
place_clean = str_remove(region_name, "[(].*")
) %>%
mutate( place_clean = str_remove(place_clean, "\\s+$"))
unique(qc_geo$place_clean)
df_base_census <- df_base_census %>%
mutate(place_clean = str_trim(where_do_you_live))
df_base_geo <- df_base_census %>%
left_join(qc_geo, by = "place_clean")
View(df_base_geo)
#Now Pulling CSD multilingualism data
csd_multi <- get_census(
dataset = "CA21",
regions = list(PR="24"),
level = "CSD",
vectors = c(
total = "v_CA21_1",
bilingual = "v_CA21_436"
)
) %>%
clean_names() %>%
mutate(multilingual_rate = bilingual / total) |>
select(geo_uid, multilingual_rate)
multi_matched_census <- df_base_geo |>
left_join(lang_data, by = "geo_uid")
multi_matched_census <- df_base_geo |>
left_join(csd_multi, by = "geo_uid")
View(multi_matched_census)
