library(here)
library(readxl)
library(stringr)
partial_data_25<- read_excel("Anonymized_Data/2025_12_partial_data.xlsx")
partial_data_25<-clean_names(partial_data_25)
#First let's clean the demographic column names with shorter names
census_clean<- partial_data_25 %>%
rename (dob = what_is_your_childs_date_of_birth,
child_gender=what_your_childs_gender,
other_caregiver = does_your_child_have_another_primary_caregiver_if_no_select_non_applicable_if_yes_please_specify_their_relationship_to_your_child,
child_english = what_languages_does_your_child_hear_spoken_to_them_on_a_regular_basis_at_least_8_hours_a_week_or_a_bit_over_an_hour_a_day_note_that_you_should_only_count_languages_that_people_interact_with_your_child_in_on_a_regular_basis_languages_that_they_overhear_others_speaking_or_that_they_only_hear_on_tv_or_through_digital_media_should_not_be_counted_english,
child_french = what_languages_does_your_child_hear_spoken_to_them_on_a_regular_basis_at_least_8_hours_a_week_or_a_bit_over_an_hour_a_day_note_that_you_should_only_count_languages_that_people_interact_with_your_child_in_on_a_regular_basis_languages_that_they_overhear_others_speaking_or_that_they_only_hear_on_tv_or_through_digital_media_should_not_be_counted_french,
child_speaks_minority_languages = what_languages_does_your_child_hear_spoken_to_them_on_a_regular_basis_at_least_8_hours_a_week_or_a_bit_over_an_hour_a_day_note_that_you_should_only_count_languages_that_people_interact_with_your_child_in_on_a_regular_basis_languages_that_they_overhear_others_speaking_or_that_they_only_hear_on_tv_or_through_digital_media_should_not_be_counted_a_language_languages_other_than_english_or_french,
minority_languages_number = how_many_languages_other_than_english_or_french_does_your_child_spoken_to_them_on_a_regular_basis,
first_minority_language = please_write_the_name_of_the_minority_language_that_your_child_is_exposed_to_if_your_child_is_spoken_to_in_more_than_one_minority_language_please_name_the_one_that_they_get_the_most_exposure_to_after_english_and_french_we_will_refer_to_this_language_as_your_childs_first_minority_language_in_later_questions,
second_minority_language = please_write_the_name_of_the_second_minority_language_that_your_child_is_exposed_to_if_your_child_is_spoken_to_in_more_than_two_minority_languages_please_name_the_one_that_they_get_the_second_most_exposure_to_after_english_french_and_the_first_minority_language_we_will_refer_to_this_language_as_your_childs_second_minority_language_in_later_questions,
third_minority_language = please_write_the_name_of_the_third_minority_language_that_your_child_is_exposed_to_the_one_that_they_get_the_least_exposure_to_we_will_refer_to_this_language_as_your_childs_third_minority_language_in_later_questions,
premature= was_your_child_born_early_a_full_term_pregnancy_is_37_weeks_or_more,
vision_hearing_delays= does_your_child_have_any_hearing_or_vision_problems_or_developmental_delays,
school_daycare_attendance = does_your_child_currently_attend_school_including_homeschooling_or_daycare_garderie,
school_language =  what_is_the_primary_language_spoken_at_your_childs_school,
daycare_language= what_is_the_primary_language_spoken_at_your_childs_daycare,
school_min_language= please_explain_32,
daycare_min_language = please_explain_34)
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Now let's clean the parent language use question names
census_clean <- census_clean %>%
rename(c1_english_percent =what_percentage_of_time_do_you_speak_each_of_the_following_languages_to_your_child_english,
c1_french_percent =what_percentage_of_time_do_you_speak_each_of_the_following_languages_to_your_child_french,
c1_first_minority_percent = what_percentage_of_time_do_you_speak_each_of_the_following_languages_to_your_child_first_minority_language,
c1_second_minority_percent = what_percentage_of_time_do_you_speak_each_of_the_following_languages_to_your_child_second_minority_language,
c1_third_minority_percent = what_percentage_of_time_do_you_speak_each_of_the_following_languages_to_your_child_third_minority_language,
c2_english_percent = what_percentage_of_the_time_does_the_childs_other_primary_caregiver_speak_each_of_the_following_languages_to_your_child_english,
c2_french_percent = what_percentage_of_the_time_does_the_childs_other_primary_caregiver_speak_each_of_the_following_languages_to_your_child_french,
c2_first_minority_percent = what_percentage_of_the_time_does_the_childs_other_primary_caregiver_speak_each_of_the_following_languages_to_your_child_first_minority_language,
c2_second_minority_percent = what_percentage_of_the_time_does_the_childs_other_primary_caregiver_speak_each_of_the_following_languages_to_your_child_second_minority_language,
c2_third_minority_percent = what_percentage_of_the_time_does_the_childs_other_primary_caregiver_speak_each_of_the_following_languages_to_your_child_third_minority_language,
two_caregiver_explicit_strategy = some_parents_follow_specific_strategies_in_their_language_use_with_their_child_such_as_dividing_the_languages_by_parent_by_time_by_day_or_by_routine_or_intentionally_using_a_single_language_with_the_child_do_you_or_your_childs_other_primary_caregiver_follow_any_language_use_strategy,
single_parent_explicit_strategy = some_parents_follow_specific_strategies_in_their_language_use_with_their_child_such_as_dividing_languages_by_parent_by_time_by_day_or_by_routine_or_intentionally_using_only_a_single_language_with_the_child_do_you_follow_any_language_use_strategy)
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#now let's clean the active use variable names
census_clean <- census_clean %>%
rename(child_english_active_category = which_best_describes_how_your_child_uses_english,
child_french_active_category = which_best_describes_how_your_child_uses_french,
child_first_minority_active_category = which_best_describes_how_your_child_uses_their_first_minority_language,
child_second_minority_active_category = which_of_these_statements_best_describes_how_your_child_uses_their_second_minority_language,
child_third_minority_active_category = which_of_best_describes_how_your_child_uses_their_third_minority_language,
child_english_active_use_percent = when_your_child_is_spoken_to_in_english_what_percentage_of_time_does_your_child_respond_in_english,
child_french_active_use_percent = when_your_child_is_spoken_to_in_french_what_percentage_of_time_does_your_child_reply_in_french,
child_first_minority_active_use_percent = when_your_child_is_spoken_to_in_their_first_minority_language_what_percentage_of_the_time_does_your_child_resply_in_this_same_language,
child_second_minority_active_use_percent = when_your_child_is_spoken_to_in_their_second_minority_language_what_percentage_of_time_does_your_child_reply_in_this_same_language,
child_third_minority_active_use_percent = when_your_child_is_spoken_to_in_their_second_minority_language_what_percentage_of_time_does_your_child_reply_in_this_same_language)
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Now let's clean the book reading variables
census_clean <- census_clean %>%
rename(books_in_eng = what_percentage_of_the_books_your_child_has_are_written_entirely_in_each_of_the_following_languages_english,
books_in_fre = what_percentage_of_the_books_your_child_has_are_written_entirely_in_each_of_the_following_languages_french,
books_in_first_mi = what_percentage_of_the_books_your_child_has_are_written_entirely_in_each_of_the_following_languages_first_minority_language,
books_in_second_mi = what_percentage_of_the_books_your_child_has_are_written_entirely_in_each_of_the_following_languages_second_minority_language,
books_in_third_mi = what_percentage_of_the_books_your_child_has_are_written_entirely_in_each_of_the_following_languages_third_minority_language,
bi_books_fre_eng = how_many_bilingual_books_that_is_books_in_which_the_story_is_written_in_two_languages_does_your_child_have_in_the_following_languages_english_and_french,
n_bi_books_eng_min = how_many_bilingual_books_that_is_books_in_which_the_story_is_written_in_two_languages_does_your_child_have_in_the_following_languages_english_and_a_minority_language,
n_bi_books_fre_min =how_many_bilingual_books_that_is_books_in_which_the_story_is_written_in_two_languages_does_your_child_have_in_the_following_languages_french_and_a_minority_language,
n_bi_books_min_min =how_many_bilingual_books_that_is_books_in_which_the_story_is_written_in_two_languages_does_your_child_have_in_the_following_languages_two_minority_languages)
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Now let's clean the parents attitudes and concerns variables
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Now let's get dates into the correct format and calculate age
census_clean$submitted_date<- as.Date(census_clean$submitted_date)
census_clean$dob <- as.Date(census_clean$dob)
census_clean$child_age_years <- time_length(
interval(census_clean$dob, census_clean$submitted_date),
unit = "years"
) |> floor()
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Let's select the variables we are going to use for the analyses in this manuscript. Build a base data frame into which to add the wrangled predictors
df_base<- census_clean %>%
select(internal_id, status, child_age_years, child_gender, other_caregiver, child_speaks_minority_languages, vision_hearing_delays, school_daycare_attendance, school_language, daycare_language,school_min_language,daycare_min_language, where_do_you_live, child_english, c1_english_percent, c2_english_percent, child_french, c1_french_percent, c2_french_percent, first_minority_language, c1_first_minority_percent, c2_first_minority_percent, second_minority_language,c1_second_minority_percent, c2_second_minority_percent, third_minority_language, c1_third_minority_percent, c2_third_minority_percent) %>%
filter(status == "Submitted", vision_hearing_delays !="Yes"|is.na(vision_hearing_delays))
#>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
#Now let's wrangle and add # of language sources for each language
df_base_sources <- df_base %>%
#Identifying which caregivers speak the minority language
mutate(english_c_sources = case_when(c1_english_percent >=25 & c2_english_percent>=25 ~ 2,
c1_english_percent>=25| c2_english_percent>=25 ~ 1,
TRUE~ 0),
french_c_sources = case_when(c1_french_percent >=25 & c2_french_percent>=25 ~ 2,
c1_french_percent>=25| c2_french_percent>=25 ~ 1,
TRUE~ 0),
first_min_c_sources = case_when(c1_first_minority_percent >=25 & c2_first_minority_percent>=25 ~ 2,
c1_first_minority_percent>=25| c2_first_minority_percent>=25 ~ 1,
TRUE~ 0),
second_min_c_sources = case_when(c1_second_minority_percent >=25 & c2_second_minority_percent>=25 ~ 2,
c1_second_minority_percent>=25| c2_second_minority_percent>=25 ~ 1,
TRUE~ 0),
third_min_c_sources = case_when(c1_third_minority_percent >=25 & c2_third_minority_percent>=25 ~ 2,
c1_third_minority_percent>=25| c2_third_minority_percent>=25 ~ 1,
TRUE~ 0)
) %>%
mutate(english_s_sources = case_when(str_detect(tolower(school_language), "english") ~ 1,
TRUE~ 0),
french_s_sources = case_when(str_detect(tolower(school_language), "french") ~ 1,
TRUE~ 0),
first_min_s_sources = if_else(school_min_language == first_minority_language |
daycare_min_language == first_minority_language,
1, 0, missing = 0),
second_min_s_sources = if_else(school_min_language == second_minority_language |
daycare_min_language == second_minority_language,
1, 0, missing = 0),
third_min_s_sources = if_else(school_min_language == third_minority_language |
daycare_min_language == third_minority_language,
1, 0, missing = 0),
) %>%
mutate(overall_eng_sources = english_c_sources +english_s_sources,
overall_fre_sources = french_c_sources + french_s_sources,
overall_first_min_sources = first_min_c_sources + first_min_s_sources,
overall_second_min_sources = second_min_c_sources +second_min_s_sources,
overall_third_min_sources = third_min_c_sources +third_min_s_sources)
df_base_census<- df_base_sources %>%
select(internal_id, where_do_you_live)
#First for csd
qc_geo <- get_census(
dataset = "CA21",
regions = list(PR = "24"),
level = "CSD",
vectors = "v_CA21_1"   # dummy vector just to retrieve geographies
) %>%
clean_names() %>%
distinct(geo_uid, region_name)
qc_geo <- qc_geo  %>%
mutate(
place_clean = str_remove(region_name, "[(].*")
)
View(qc_geo)
df_base_census <- df_base_census |>
mutate(place_clean = str_trim(where_do_you_live))
View(df_base_census)
df_base_geo <- df_base_census %>%
left_join(qc_geo, by = "place_clean")
View(df_base_geo)
unique(df_base_census$place_clean)
unique(qc_geo$place_clean)
