#First let's get rid of the screened out people
data_clean<- partial_data %>%
dplyr::filter(status=="Submitted") %>%
dplyr::filter(by_clicking_on_the_i_agree_button_i_certify_that_i_have_read_the_information_and_consent_form_i_voluntarily_and_freely_consent_to_participate_in_this_research_project== "I agree") %>%
dplyr::filter(has_your_child_been_diagnosed_with_a_speech_disorder_or_a_language_delay== "No")
#Now let's select only the columns of data that we need
columns_drop<- c(2,3,4,5,7,8,9,10,11,12,13,14,15,18,19,31,21,22,25,28,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,92,103,114,120,128,136,140,141,143,144,146,150,151,153,154,156,160,161,163,164,166,170,171,173,174,176,180,181,183,184,185)
data_clean<- data_clean %>%
dplyr::select(-all_of(columns_drop))
#Now let's clean the column names from the very long ones to ones easy to call in the environment by using the csv file I created containing the survey expost names cleaned from R and shorter manageable names I would like for them to be called
data_clean <- data_clean %>%
rename(!!!setNames(column_clean_names$old_names,
column_clean_names$new_names))
#Now let's get dates into the correct format
data_clean$survey_date<- as.Date(data_clean$survey_date)
data_clean$child_dob <- as.Date(data_clean$child_dob)
#Let's make an age variable, calculated from the date of the survey and the date of birth
data_clean$child_age_years <- time_length(
interval(data_clean$child_dob, data_clean$survey_date),
unit = "years"
) |> floor()
#1 let's get the census division data for rate of multilingualism
qc_geo_cd <- get_census(
dataset = "CA21",
regions = list(PR = "24"),
level = "CD",
vectors = "v_CA21_1"   # dummy vector just to retrieve geographies
) %>%
clean_names() %>%
distinct(geo_uid, region_name)
#Got the census division names and geo_uid codes so that we can easily get the info from rate of multilingualsim
#But the name of regions has wierd characters and I need it to match with the names on the survey. So fixing it.
qc_geo_cd <- qc_geo_cd  %>%
mutate(
census_subdivision = str_remove(region_name, "[(].*")
) %>%
mutate(census_subdivision = str_remove(census_subdivision , "\\s+$")) %>%
select(-region_name)
#Now let's pull the census division bilingualism rate
qc_cd_bilingual_rate <- get_census(
dataset = "CA21",
regions = list(PR="24"),
level = "CD",
vectors = c(
total = "v_CA21_1",
bilingual = "v_CA21_436"
) ) %>%
clean_names() %>%
mutate(multilingual_rate = total/ bilingual) |>
select(geo_uid, multilingual_rate)
#let's combine information for both
cd_multilingual_rate<-qc_geo_cd %>%
left_join(qc_cd_bilingual_rate, by="geo_uid")
#finally, let's merge it with our own data frame
clean_w_predictors<- data_clean %>%
left_join(cd_multilingual_rate, by="census_subdivision")
View(clean_w_predictors)
View(clean_w_predictors)
english_sources<- data_clean %>%
select(internal_id, caregiver_1_english, caregiver_2_english, older_siblings_english, younger_siblings_english, other_family_english, child_friends_english, teachers_english)
View(english_sources)
english_sources<- data_clean %>%
select(internal_id, caregiver_1_english, caregiver_2_english, older_siblings_english, younger_siblings_english, other_family_english, child_friends_english, teachers_english) %>%
mutate(english_sources_n = rowSums(!is.na(across(-internal_id))))
english_sources<- data_clean %>%
select(internal_id, caregiver_1_english, caregiver_2_english, older_siblings_english, younger_siblings_english, other_family_english, child_friends_english, teachers_english) %>%
mutate(english_sources_n = rowSums(!is.na(across(-internal_id)))) %>%
select(internal_id, english_sources_n)
french_sources<- data_clean %>%
select(internal_id, caregiver_1_french, caregiver_2_french, older_siblings_french, younger_siblings_french, other_family_french, child_friends_french, teachers_french) %>%
mutate(french_sources_n = rowSums(!is.na(across(-internal_id)))) %>%
select(internal_id, french_sources_n)
first_min_sources<- data_clean %>%
select(internal_id, caregiver_1_first_minority, caregiver_2_first_minority, older_siblings_first_minority, younger_siblings_first_minority, other_family_first_minority, child_friends_first_minority, teachers_first_minority) %>%
mutate(first_min_sources_n = rowSums(!is.na(across(-internal_id)))) %>%
select(internal_id, first_min_sources_n)
second_min_sources<- data_clean %>%
select(internal_id, caregiver_1_second_minority, caregiver_2_second_minority, older_siblings_second_minority, younger_siblings_second_minority, other_family_second_minority, child_friends_second_minority, teachers_second_minority) %>%
mutate(second_min_sources_n = rowSums(!is.na(across(-internal_id)))) %>%
select(internal_id, second_min_sources_n)
third_min_sources<- data_clean %>%
select(internal_id, caregiver_1_third_minority, caregiver_2_third_minority, older_siblings_third_minority, younger_siblings_third_minority, other_family_third_minority, child_friends_third_minority, teachers_third_minority) %>%
mutate(third_min_sources_n = rowSums(!is.na(across(-internal_id)))) %>%
select(internal_id, third_min_sources_n)
all_language_sources<- rbind(english_sources, french_sources)
View(french_sources)
all_language_sources<- english_sources %>%
left_join(french_sources) %>%
left_join(first_min_sources) %>%
left_join(second_min_sources) %>%
left_join(third_min_sources)
View(all_language_sources)
clean_w_predictors <- clean_w_predictors %>%
left_join(all_language_sources, by="internal_id")
View(clean_w_predictors)
# Look for mother tongue variables
search_census_vectors(
"mother tongue",
dataset = "CA21"
)
languages_heard<- clean_w_predictors %>%
dplyr::select(internal_id, census_subdivision, child_english, child_french, child_first_minority, child_second_minority, child_third_minority, geo_uid)
View(languages_heard)
?pivot_longer
languages_heard<- clean_w_predictors %>%
dplyr::select(internal_id, census_subdivision, child_english, child_french, child_first_minority, child_second_minority, child_third_minority, geo_uid) %>%
pivot_longer(cols=child_english:child_third_minority, names_to="language_type",values_to="language")
#let's create a list of the languages in the survey
survey_languages <- languages_heard %>%
distinct(language) %>%
filter(!is.na(language)) %>%
arrange(language)
View(survey_languages)
languages_heard<- clean_w_predictors %>%
dplyr::select(internal_id, census_subdivision, child_english, child_french, child_first_minority, child_second_minority, child_third_minority, geo_uid) %>%
pivot_longer(cols=child_english:child_third_minority, names_to="language_type",values_to="language") %>%
mutate(language = case_when(language == "Anglais"~"English",
language == "Francais"~"French",
language == "Berbère"~"Berber",
language== "Portugais"~"Portuguese",
T~ language
))
#let's create a list of the languages in the survey
survey_languages <- languages_heard %>%
distinct(language) %>%
filter(!is.na(language)) %>%
arrange(language)
ca21_vectors <- list_census_vectors("CA21")
mother_tongue_vars <- ca21_vectors %>%
filter(
str_detect(
str_to_lower(label),
"mother tongue"
)
)
mother_tongue_vars %>%
select(vector, type, label, units, parent_vector) %>%
print(n = 100)
View(mother_tongue_vars)
View(mother_tongue_vars)
mother_tongue_children <- child_census_vectors(
mother_tongue_parent,
leaves_only = TRUE
)
mother_tongue_children <- child_census_vectors(
"v_CA21_1174",
leaves_only = TRUE
)
View(mother_tongue_children)
mother_tongue_children %>%
select(vector, label, parent_vector) %>%
print(n = 500)
mother_tongue_parents <- ca21_vectors %>%
filter(
vector %in% unique(mother_tongue_children$parent_vector)
) %>%
select(vector, label, parent_vector)
View(mother_tongue_parents)
mother_tongue_parents$label
multiple_response_vector <- mother_tongue_parents %>%
filter(label == "Multiple responses") %>%
pull(vector)
multiple_response_children <- child_census_vectors(
multiple_response_vector,
leaves_only = TRUE
)
#This is going to keep census data only for single language responses, since the multiple language responses are like French+non-official language, so I have no way of adjudicating the count to a specific language.
single_language_vectors <- mother_tongue_children %>%
filter(!vector %in% multiple_response_children$vector)
single_language_vectors %>%
select(vector, label, parent_vector) %>%
print(n = 100)
single_language_vectors %>%
filter(
str_detect(
str_to_lower(label),
"spanish|arabic|mandarin|cantonese|portuguese|italian"
)
) %>%
select(vector, label, parent_vector)
language_lookup <- single_language_vectors %>%
select(
vector,
census_language = label
)
View(language_lookup)
language_vectors <- language_lookup$vector
# Break vector IDs into batches of 50
vector_batches <- split(
language_vectors,
ceiling(seq_along(language_vectors) / 50)
)
language_batches <- lapply(
vector_batches,
function(x) {
get_census(
dataset = "CA21",
regions = list(PR = "24"),
level = "CD",
vectors = x
)
}
)
qc_cd_languages_wide <- language_batches[[1]]
if (length(language_batches) > 1) {
for (i in 2:length(language_batches)) {
new_vectors <- intersect(
language_vectors,
names(language_batches[[i]])
)
qc_cd_languages_wide <- qc_cd_languages_wide %>%
left_join(
language_batches[[i]] %>%
select(CDUID, all_of(new_vectors)),
by = "CDUID"
)
}
}
View(qc_cd_languages_wide)
if (length(language_batches) > 1) {
for (i in 2:length(language_batches)) {
new_vectors <- intersect(
language_vectors,
names(language_batches[[i]])
)
qc_cd_languages_wide <- qc_cd_languages_wide %>%
left_join(
language_batches[[i]] %>%
select(GeoUID, all_of(new_vectors)),
by = "GeoUID"
)
}
}
glimpse(qc_cd_languages_wide)
View(qc_cd_languages_wide)
length(language_vectors)
sum(language_vectors %in% names(qc_cd_languages_wide))
setdiff(language_vectors, names(qc_cd_languages_wide))
names(language_batches[[1]])
language_batches <- lapply(
vector_batches,
function(x) {
get_census(
dataset = "CA21",
regions = list(PR = "24"),
level = "CD",
vectors = x,
labels = "short"
)
}
)
qc_cd_languages_wide <- language_batches[[1]]
if (length(language_batches) > 1) {
for (i in 2:length(language_batches)) {
new_vectors <- intersect(
language_vectors,
names(language_batches[[i]])
)
qc_cd_languages_wide <- qc_cd_languages_wide %>%
left_join(
language_batches[[i]] %>%
select(GeoUID, all_of(new_vectors)),
by = "GeoUID"
)
}
}
qc_cd_languages_wide <- language_batches[[1]]
for (i in 2:length(language_batches)) {
new_cols <- setdiff(
names(language_batches[[i]]),
names(qc_cd_languages_wide)
)
qc_cd_languages_wide <- qc_cd_languages_wide %>%
left_join(
language_batches[[i]] %>%
select(GeoUID, all_of(new_cols)),
by = "GeoUID"
)
}
census_language_cd <- qc_cd_languages_wide %>%
pivot_longer(
cols = starts_with("v_CA21_"),
names_to = "vector",
values_to = "mother_tongue_n"
)
View(census_language_cd)
census_language_cd <- census_language_cd %>%
left_join(
language_lookup,
by = "vector"
)
sum(is.na(census_language_cd$census_language))
