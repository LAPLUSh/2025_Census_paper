.groups = "drop"
) %>%
mutate(
language_group = case_when(
n_languages >= 3 ~ "Trilinguals+",
n_languages == 2 &
has_french & has_english ~
"Community bilinguals",
n_languages == 2 &
n_heritage == 1 ~
"Community–Heritage bilinguals",
TRUE ~ NA_character_
),
language_group = factor(
language_group,
levels = c(
"Community bilinguals",
"Community–Heritage bilinguals",
"Trilinguals+"
)
)
)
# Check group sizes
language_groups %>%
count(language_group)
# ============================================================
# STEP 2: Join language groups to binary outcome
# ============================================================
binary_plot_data <- child_data %>%
select(
internal_id,
degree_of_activeness_combined
) %>%
left_join(
language_groups %>%
select(internal_id, language_group),
by = "internal_id"
)
# Check for missing classifications
binary_plot_data %>%
count(
language_group,
degree_of_activeness_combined
)
# ============================================================
# STEP 3: Calculate group composition for 0 and 1
# ============================================================
binary_distribution <- binary_plot_data %>%
filter(
!is.na(degree_of_activeness_combined),
!is.na(language_group)
) %>%
count(
degree_of_activeness_combined,
language_group,
name = "n"
) %>%
group_by(degree_of_activeness_combined) %>%
mutate(
percentage = 100 * n / sum(n)
) %>%
ungroup()
binary_distribution
# ============================================================
# STEP 4: 100% stacked bar chart
# ============================================================
binary_figure <- ggplot(
binary_distribution,
aes(
x = factor(
degree_of_activeness_combined,
levels = c(0, 1),
labels = c("Score 0", "Score 1")
),
y = percentage,
fill = language_group
)
) +
geom_col(
width = 0.65,
color = "white",
linewidth = 0.5
) +
geom_text(
aes(
label = if_else(
percentage >= 5,
paste0(round(percentage, 1), "%"),
""
)
),
position = position_stack(vjust = 0.5),
size = 4.5
) +
coord_flip() +
scale_fill_manual(
values = c(
"Community bilinguals" = "#8DAEE1",
"Community–Heritage bilinguals" = "#B0DA87",
"Trilinguals+" = "#FAE0BD"
)
) +
scale_y_continuous(
limits = c(0, 100),
breaks = seq(0, 100, 20),
labels = function(x) paste0(x, "%"),
expand = c(0, 0)
) +
labs(
x = NULL,
y = "Percentage of children",
fill = "Language group",
title = "Language profiles by combined activeness score"
) +
theme_classic(base_size = 15) +
theme(
plot.title = element_text(
face = "bold",
size = 16
),
legend.position = "bottom",
legend.title = element_blank(),
legend.text = element_text(size = 12),
axis.text = element_text(size = 13)
)
binary_figure
ggsave(
"Figure_binary_activeness_language_groups.pdf",
binary_figure,
width = 7.2,
height = 4.5,
bg = "white"
)
binary_by_group <- binary_plot_data %>%
filter(
!is.na(degree_of_activeness_combined),
!is.na(language_group)
) %>%
group_by(language_group) %>%
summarise(
N = n(),
n_score_1 = sum(degree_of_activeness_combined == 1),
percent_score_1 = 100 * mean(
degree_of_activeness_combined == 1
),
.groups = "drop"
)
binary_by_group
#Let's do a chi-square test of independence to see if thecategories of children who score 1 in the binary score are distributed the same way they are in our sample
# Create contingency table
activeness_table <- table(
binary_plot_data$language_group,
binary_plot_data$degree_of_activeness_combined
)
activeness_table
# Pearson chi-square test
chi_result <- chisq.test(
activeness_table,
correct = FALSE
)
chi_result
# Check expected frequencies
chi_result$expected
# Standardized Pearson residuals
chi_result$stdres
# Cramer's V
cramers_v <- sqrt(
unname(chi_result$statistic) /
(sum(activeness_table) *
min(dim(activeness_table) - 1))
)
cramers_v
# Summarize binary outcome by language group
pairwise_data <- binary_plot_data %>%
filter(
!is.na(language_group),
!is.na(degree_of_activeness_combined)
) %>%
group_by(language_group) %>%
summarise(
n_score_1 = sum(degree_of_activeness_combined == 1),
N = n(),
.groups = "drop"
)
# Pairwise comparisons of proportions
pairwise_result <- pairwise.prop.test(
x = pairwise_data$n_score_1,
n = pairwise_data$N,
p.adjust.method = "holm"
)
pairwise_result
#Let's then also make a sensitivity analyses that does not punish trilingual children making them harder to achieve the score of 1 because they have to surpass the threshold for more languages
# ============================================================
# STEP 1: Calculate proportion of active languages per child
# ============================================================
child_activeness <- model_data_long %>%
group_by(internal_id) %>%
summarise(
n_languages = n(),
n_valid = sum(!is.na(active_use)),
n_active = sum(
active_use >= 2,
na.rm = TRUE
),
proportion_active = if_else(
n_valid > 0,
n_active / n_valid,
NA_real_
),
.groups = "drop"
)
# Join language group classifications
sensitivity_data <- child_activeness %>%
left_join(
language_groups %>%
select(internal_id, language_group),
by = "internal_id"
)
# Check results
sensitivity_data %>%
group_by(language_group) %>%
summarise(
N = n(),
Mean_proportion = mean(
proportion_active,
na.rm = TRUE
),
SD = sd(
proportion_active,
na.rm = TRUE
),
Median = median(
proportion_active,
na.rm = TRUE
),
.groups = "drop"
)
# ============================================================
# STEP 2: Visualize proportions across language groups
# ============================================================
sensitivity_plot <- sensitivity_data %>%
filter(
!is.na(language_group),
!is.na(proportion_active)
) %>%
ggplot(
aes(
x = language_group,
y = proportion_active,
fill = language_group
)
) +
geom_jitter(
width = 0.15,
height = 0,
alpha = 0.35,
size = 2,
shape = 21
) +
stat_summary(
fun = mean,
geom = "point",
shape = 23,
size = 4,
fill = "white",
color = "black"
) +
scale_fill_manual(
values = c(
"Community bilinguals" = "#8DAEE1",
"Community–Heritage bilinguals" = "#B0DA87",
"Trilinguals+" = "#FAE0BD"
)
) +
scale_y_continuous(
labels = scales::percent,
limits = c(0, 1)
) +
labs(
x = NULL,
y = "Proportion of languages meeting activeness criterion",
title = "Sensitivity analysis: Proportion of active languages"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "none",
axis.text.x = element_text(
angle = 15,
hjust = 1
)
)
sensitivity_plot
# ============================================================
# STEP 3: Kruskal-Wallis test
# ============================================================
sensitivity_complete <- sensitivity_data %>%
filter(
!is.na(language_group),
!is.na(proportion_active)
)
kruskal_result <- kruskal.test(
proportion_active ~ language_group,
data = sensitivity_complete
)
kruskal_result
pairwise.wilcox.test(
x = sensitivity_complete$proportion_active,
g = sensitivity_complete$language_group,
p.adjust.method = "holm",
exact = FALSE
)
# ============================================================
# STEP 4: Exploratory binomial regression
# ============================================================
binomial_model <- glm(
cbind(
n_active,
n_valid - n_active
) ~ language_group,
data = sensitivity_data %>%
filter(
!is.na(language_group),
n_valid > 0
),
family = binomial
)
summary(binomial_model)
# Omnibus test of language group
drop1(
binomial_model,
test = "Chisq"
)
#Sensitivity analyses show no differences between groups, meaning that the stringent binary outcome causes the group differences, that is, if children did not have to speak more than two languages, the groups would be comparable, but because some do have to... those children tend to get less classified as 'active users' In other words. It is harder to be an active user when you have to speak three languages.
#Final exploratory analysis. Are some specific languages disproportionately falling below the activeness threshold we set up?
# ============================================================
# FIGURE: COMMUNITY VS HERITAGE LANGUAGE STATUS
# FOR LANGUAGES BELOW THRESHOLD
# Two rows: Activeness and Interlocutor matching
# Two columns: Community–Heritage bilinguals and Trilinguals+
# ============================================================
library(dplyr)
library(ggplot2)
library(tidyr)
library(patchwork)
# ------------------------------------------------------------
# 1. Set thresholds
# ------------------------------------------------------------
ACTIVE_THRESHOLD <- 2
MATCHING_THRESHOLD <- 80   # <-- change this if your threshold differs
# ------------------------------------------------------------
# 2. Prepare language-level data
# ------------------------------------------------------------
threshold_plot_data <- model_data_long %>%
left_join(
language_groups %>%
select(internal_id, language_group),
by = "internal_id"
) %>%
mutate(
language_type = factor(
as.character(language_type),
levels = c("Community", "Heritage")
),
below_activeness = case_when(
is.na(active_use) ~ NA_integer_,
active_use < ACTIVE_THRESHOLD ~ 1L,
active_use >= ACTIVE_THRESHOLD ~ 0L
),
below_matching = case_when(
is.na(interlocutor_matching) ~ NA_integer_,
interlocutor_matching < MATCHING_THRESHOLD ~ 1L,
interlocutor_matching >= MATCHING_THRESHOLD ~ 0L
)
) %>%
filter(
language_group %in% c(
"Community–Heritage bilinguals",
"Trilinguals+"
),
!is.na(language_group),
!is.na(language_type)
)
# ------------------------------------------------------------
# 3. Summarize percentages below threshold for each outcome
# ------------------------------------------------------------
activeness_summary <- threshold_plot_data %>%
filter(!is.na(below_activeness)) %>%
group_by(language_group, language_type) %>%
summarise(
n_languages = n(),
n_below = sum(below_activeness == 1),
percent_below = 100 * mean(below_activeness == 1),
.groups = "drop"
) %>%
mutate(
outcome_metric = "Active language use"
)
matching_summary <- threshold_plot_data %>%
filter(!is.na(below_matching)) %>%
group_by(language_group, language_type) %>%
summarise(
n_languages = n(),
n_below = sum(below_matching == 1),
percent_below = 100 * mean(below_matching == 1),
.groups = "drop"
) %>%
mutate(
outcome_metric = "Interlocutor matching"
)
threshold_summary <- bind_rows(
activeness_summary,
matching_summary
) %>%
mutate(
outcome_metric = factor(
outcome_metric,
levels = c(
"Active language use",
"Interlocutor matching"
)
),
language_group = factor(
language_group,
levels = c(
"Community–Heritage bilinguals",
"Trilinguals+"
)
)
)
threshold_summary
# ------------------------------------------------------------
# 4. Plot
# ------------------------------------------------------------
threshold_figure <- ggplot(
threshold_summary,
aes(
x = language_type,
y = percent_below,
fill = language_type
)
) +
geom_col(width = 0.6) +
geom_text(
aes(
label = paste0(round(percent_below, 1), "%")
),
vjust = -0.4,
size = 4.3
) +
facet_grid(
outcome_metric ~ language_group
) +
scale_fill_manual(
values = c(
"Community" = "#8DAEE1",
"Heritage" = "#B0DA87"
),
drop = FALSE
) +
scale_y_continuous(
limits = c(0, 110),
breaks = seq(0, 100, 20),
labels = function(x) paste0(x, "%")
) +
labs(
x = NULL,
y = "Languages below threshold (%)",
fill = "Language type",
title = "Language status composition of languages below threshold"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "bottom",
strip.text = element_text(
size = 13,
face = "bold"
),
axis.text.x = element_text(size = 12)
)
threshold_figure
# ------------------------------------------------------------
# 5. Save
# ------------------------------------------------------------
ggsave(
"Figure_below_threshold_by_status_and_outcome.pdf",
threshold_figure,
width = 8.5,
height = 7,
bg = "white"
)
# Mac nemar tests for the community language group and the comunity heritage groups
community_paired <- inactive_language_data %>%
filter(
language_group == "Community bilinguals"
) %>%
mutate(
language = case_when(
str_to_lower(str_squish(as.character(language))) %in%
c("english", "anglais") ~ "English",
str_to_lower(str_squish(as.character(language))) %in%
c("french", "français", "francais") ~ "French",
TRUE ~ as.character(language)
)
) %>%
filter(language %in% c("French", "English")) %>%
select(internal_id, language, is_active) %>%
distinct() %>%
pivot_wider(
names_from = language,
values_from = is_active
) %>%
filter(!is.na(French), !is.na(English))
