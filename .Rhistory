child_age_years_z +
language_type +
(1 | internal_id),
data = model_data_long,
REML = FALSE,
na.action = na.omit
)
matching_base <- lmer(
interlocutor_matching ~
overall_exposure_z +
child_age_years_z +
language_type +
(1 | internal_id),
data = model_data_long,
REML = FALSE,
na.action = na.omit
)
# Inspect base models
summary(active_base)
summary(matching_base)
test_predictors <- function(outcome, data) {
map_dfr(
candidate_predictors,
function(pred) {
# Variables required for this comparison
required_vars <- c(
outcome,
"overall_exposure_z",
"child_age_years_z",
"language_type",
pred,
"internal_id"
)
# Matched sample for base and expanded model
comparison_data <- data %>%
drop_na(all_of(required_vars))
# -------------------------
# BASE MODEL
# -------------------------
base_formula <- as.formula(
paste0(
outcome,
" ~ overall_exposure_z + ",
"child_age_years_z + ",
"language_type + ",
"(1 | internal_id)"
)
)
base_model <- lmer(
base_formula,
data = comparison_data,
REML = FALSE
)
# -------------------------
# EXPANDED MODEL
# -------------------------
expanded_formula <- as.formula(
paste0(
outcome,
" ~ overall_exposure_z + ",
"child_age_years_z + ",
"language_type + ",
pred,
" + (1 | internal_id)"
)
)
expanded_model <- lmer(
expanded_formula,
data = comparison_data,
REML = FALSE
)
# -------------------------
# LIKELIHOOD-RATIO TEST
# -------------------------
comparison <- anova(
base_model,
expanded_model
)
# -------------------------
# RETURN RESULTS
# -------------------------
tibble(
predictor = pred,
n_observations = nrow(comparison_data),
n_children = n_distinct(comparison_data$internal_id),
AIC_base = AIC(base_model),
AIC_added = AIC(expanded_model),
delta_AIC = AIC(expanded_model) - AIC(base_model),
BIC_base = BIC(base_model),
BIC_added = BIC(expanded_model),
delta_BIC = BIC(expanded_model) - BIC(base_model),
Chisq = comparison$Chisq[2],
df = comparison$`Chi Df`[2],
p = comparison$`Pr(>Chisq)`[2]
)
}
)
}
active_comparisons <- test_predictors(
outcome = "active_use",
data = model_data_long
)
library(purrr)
active_comparisons <- test_predictors(
outcome = "active_use",
data = model_data_long
)
matching_comparisons <- test_predictors(
outcome = "interlocutor_matching",
data = model_data_long
)
predictor_labels <- c(
"speaker_rate_z" = "Speaker rate",
"book_resources_z" = "Book resources",
"book_reading_z" = "Book reading",
"status_attitudes_z" = "Status attitudes",
"solidarity_attitudes_z" = "Solidarity attitudes",
"cognition_attitudes_z" = "Cognition attitudes",
"exposure_fluency_worries_z" = "Exposure-fluency worries",
"cognitive_difficulties_worries_z" = "Cognitive difficulties worries",
"school_difficulties_worries_z" = "School difficulties worries"
)
active_comparisons <- active_comparisons %>%
mutate(
predictor_label = recode(
predictor,
!!!predictor_labels
)
) %>%
arrange(delta_AIC) %>%
select(
predictor_label,
n_observations,
n_children,
AIC_base,
AIC_added,
delta_AIC,
BIC_base,
BIC_added,
delta_BIC,
Chisq,
df,
p
)
matching_comparisons <- matching_comparisons %>%
mutate(
predictor_label = recode(
predictor,
!!!predictor_labels
)
) %>%
arrange(delta_AIC) %>%
select(
predictor_label,
n_observations,
n_children,
AIC_base,
AIC_added,
delta_AIC,
BIC_base,
BIC_added,
delta_BIC,
Chisq,
p
)
View(active_comparisons)
View(matching_comparisons)
# ------------------------------------------------------------
# 1. FUNCTION FOR ONE HIERARCHICAL STEP
# ------------------------------------------------------------
compare_hierarchical_step <- function(
outcome,
current_predictors,
new_predictor,
data) {
# All variables needed for BOTH models
required_vars <- c(
outcome,
current_predictors,
new_predictor,
"internal_id"
)
comparison_data <- data %>%
drop_na(all_of(required_vars))
# Previous model
old_formula <- as.formula(
paste0(
outcome,
" ~ ",
paste(current_predictors, collapse = " + "),
" + (1 | internal_id)"
)
)
# Model with new predictor
new_formula <- as.formula(
paste0(
outcome,
" ~ ",
paste(c(current_predictors, new_predictor),
collapse = " + "),
" + (1 | internal_id)"
)
)
old_model <- lmer(
old_formula,
data = comparison_data,
REML = FALSE
)
new_model <- lmer(
new_formula,
data = comparison_data,
REML = FALSE
)
comparison <- anova(
old_model,
new_model
)
tibble(
added_predictor = new_predictor,
n_observations = nrow(comparison_data),
n_children = n_distinct(comparison_data$internal_id),
AIC_previous = AIC(old_model),
AIC_new = AIC(new_model),
delta_AIC = AIC(new_model) - AIC(old_model),
BIC_previous = BIC(old_model),
BIC_new = BIC(new_model),
delta_BIC = BIC(new_model) - BIC(old_model),
Chisq = comparison$Chisq[2],
p = comparison$`Pr(>Chisq)`[2]
)
}
# ============================================================
# 2. ACTIVE LANGUAGE USE
# ============================================================
# Base predictors that are always retained
