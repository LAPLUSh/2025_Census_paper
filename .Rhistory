)
# ============================================================
# AUDIT INTERACTION MODELS: OBSERVED DATA AND MODEL PREDICTIONS
# ============================================================
library(tidyverse)
library(lme4)
# 1. Actual outcome distributions
observed_summary <- bind_rows(
active_int_data %>%
group_by(language_type) %>%
summarise(
outcome = "Active use",
n_languages = n(),
n_children = n_distinct(internal_id),
mean = mean(active_use),
median = median(active_use),
sd = sd(active_use),
.groups = "drop"
),
matching_int_data %>%
group_by(language_type) %>%
summarise(
outcome = "Interlocutor matching",
n_languages = n(),
n_children = n_distinct(internal_id),
mean = mean(interlocutor_matching),
median = median(interlocutor_matching),
sd = sd(interlocutor_matching),
.groups = "drop"
)
)
print(observed_summary)
# 2. Compare predictor distributions across language types
predictor_names <- c(
"overall_exposure_z",
"speaker_rate_z",
"book_resources_z",
"book_reading_z",
"number_sources_z"
)
predictor_distributions <- active_int_data %>%
select(language_type, all_of(predictor_names)) %>%
pivot_longer(
cols = all_of(predictor_names),
names_to = "predictor",
values_to = "value"
) %>%
group_by(language_type, predictor) %>%
summarise(
n = n(),
min = min(value),
q10 = quantile(value, 0.10),
median = median(value),
q90 = quantile(value, 0.90),
max = max(value),
.groups = "drop"
)
print(predictor_distributions, n = Inf)
# 3. Are model predictions outside possible ranges
# even when evaluated at OBSERVED predictor combinations?
check_predictions <- function(model, data, outcome,
lower, upper) {
predicted <- predict(
model,
newdata = data,
re.form = NA
)
tibble(
outcome = outcome,
n = length(predicted),
predicted_min = min(predicted),
predicted_max = max(predicted),
n_below_possible = sum(predicted < lower),
n_above_possible = sum(predicted > upper)
)
}
prediction_audit <- bind_rows(
check_predictions(
active_interaction,
active_int_data,
"Active use", 0, 3
),
check_predictions(
matching_interaction,
matching_int_data,
"Interlocutor matching", 0, 100
)
)
print(prediction_audit)
# 4. Check model convergence and singularity
model_list <- list(
active_main = active_main,
active_interaction = active_interaction,
matching_main = matching_main,
matching_interaction = matching_interaction
)
purrr::imap_dfr(
model_list,
function(fit, model_name) {
tibble(
model = model_name,
n_observations = nobs(fit),
singular = isSingular(fit),
convergence_messages = paste(
fit@optinfo$conv$lme4$messages,
collapse = "; "
)
)
}
)
# ============================================================
# TARGETED MODERATION MODEL: INTERLOCUTOR MATCHING
# Full main effects + exposure and reading interactions
# ============================================================
matching_targeted <- lmer(
interlocutor_matching ~
overall_exposure_z +
child_age_years_z +
speaker_rate_z +
book_resources_z +
book_reading_z +
number_sources_z +
language_type +
overall_exposure_z:language_type +
book_reading_z:language_type +
(1 | internal_id),
data = matching_int_data,
REML = FALSE
)
# Compare targeted moderation model against main effects
anova(matching_main, matching_targeted)
# Compare targeted against full interaction model
anova(matching_targeted, matching_interaction)
# Inspect coefficients
summary(matching_targeted)
# Check fit and diagnostics
AIC(matching_main, matching_targeted, matching_interaction)
BIC(matching_main, matching_targeted, matching_interaction)
lme4::isSingular(matching_targeted)
# ============================================================
# TARGETED MODERATION: ESTIMATED SLOPES
# ============================================================
library(emmeans)
library(dplyr)
library(ggplot2)
# Estimate exposure slopes by language type
exposure_trends <- emtrends(
matching_targeted,
~ language_type,
var = "overall_exposure_z",
lmer.df = "asymptotic"
)
# Estimate reading slopes by language type
reading_trends <- emtrends(
matching_targeted,
~ language_type,
var = "book_reading_z",
lmer.df = "asymptotic"
)
# Display slopes and confidence intervals
summary(exposure_trends, infer = TRUE)
summary(reading_trends, infer = TRUE)
# Directly test differences between group slopes
pairs(exposure_trends)
pairs(reading_trends)
# Prepare plotting data
make_slope_data <- function(trends, label, predictor) {
results <- as.data.frame(
confint(trends)
)
slope_column <- paste0(predictor, ".trend")
results %>%
transmute(
predictor = label,
language_type,
slope = .data[[slope_column]],
lower = asymp.LCL,
upper = asymp.UCL
)
}
slope_plot_data <- bind_rows(
make_slope_data(
exposure_trends,
"Overall exposure",
"overall_exposure_z"
),
make_slope_data(
reading_trends,
"Book reading",
"book_reading_z"
)
)
# Plot estimated slopes
slope_figure <- ggplot(
slope_plot_data,
aes(
x = predictor,
y = slope,
color = language_type
)
) +
geom_hline(
yintercept = 0,
linetype = "dashed",
color = "grey60"
) +
geom_pointrange(
aes(ymin = lower, ymax = upper),
position = position_dodge(width = 0.5),
linewidth = 0.7
) +
scale_color_manual(
values = c(
"Community" = "#8DAEE1",
"Heritage" = "#B0DA87"
)
) +
labs(
x = NULL,
y = "Change in matching (percentage points per 1 SD)",
color = "Language type",
title = "Does language status moderate matching?",
subtitle = "Estimated slopes from the targeted mixed model"
) +
theme_classic(base_size = 14) +
theme(
legend.position = "bottom"
)
slope_figure
ggsave(
"matching_moderation_slopes.png",
slope_figure,
width = 8,
height = 5,
dpi = 300,
bg = "white"
)
