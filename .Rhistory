use = "pairwise.complete.obs",
method = "spearman"
)
corrplot(
english_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
french_cor_data <- for_correlation_long %>%
filter(language == "French") %>%
distinct(internal_id, .keep_all = TRUE) %>%
select(child_age_years, beleifs_ahead_in_life, beleifs_belonging, beliefs_cognitive_benefits, worry_master_languages, worry_cognitive_difficulties, worry_school_difficulties,
child_french_active_use_category,
language_knowledge_rate,
overall_exposure_french_child,
book_resources_french,
caregiver_french_book_reading,
child_french_interlocutor_matching
)
french_cor_data <- french_cor_data %>%
mutate(across(everything(), as.numeric))
french_correlation <- cor(
french_cor_data,
use = "pairwise.complete.obs",
method = "spearman"
)
corrplot(
french_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
#Minority Matrix
minority_long <- clean_w_predictors %>%
# First standardize all first/second/third variables
rename(
# Language name
minority_language_first = child_first_minority,
minority_language_second = child_second_minority,
minority_language_third = child_third_minority,
# Exposure
minority_overall_exposure_first = overall_exposure_first_min_child,
minority_overall_exposure_second = overall_exposure_second_min_child,
minority_overall_exposure_third = overall_exposure_third_min_child,
# Book resources
minority_book_resources_first = book_resources_first_minority,
minority_book_resources_second = book_resources_second_minority,
minority_book_resources_third = book_resources_third_minority,
# Book reading
minority_book_reading_first = caregiver_first_min_book_reading,
minority_book_reading_second = caregiver_second_min_book_reading,
minority_book_reading_third = caregiver_third_min_book_reading,
# Active use
minority_active_use_first = child_first_min_active_use_category,
minority_active_use_second = child_second_min_active_use_category,
minority_active_use_third = child_third_min_active_use_category,
# Interlocutor matching
minority_interlocutor_matching_first =
child_first_min_interlocutor_matching,
minority_interlocutor_matching_second =
child_second_min_interlocutor_matching,
minority_interlocutor_matching_third =
child_third_min_interlocutor_matching
) %>%
# Turn first/second/third into rows
pivot_longer(
cols = matches(
"^minority_(language|overall_exposure|book_resources|book_reading|active_use|interlocutor_matching)_(first|second|third)$"
),
names_to = c(".value", "minority_order"),
names_pattern = "(.+)_(first|second|third)$"
) %>%
# Clean the actual language name
mutate(
minority_language = case_when(
minority_language == "Anglais" ~ "English",
minority_language == "Francais" ~ "French",
minority_language == "Berbère" ~ "Berber",
minority_language == "Portugais" ~ "Portuguese",
minority_language == "Allemand" ~ "German",
minority_language == "allemand" ~ "German",
minority_language == "Suisse-Allemand" ~ "German",
minority_language == "Espagnol" ~ "Spanish",
minority_language == "espagnol" ~ "Spanish",
minority_language == "hungarian" ~ "Hungarian",
minority_language == "Polonais" ~ "Polish",
minority_language == "polonais" ~ "Polish",
minority_language == "Spanish and German" ~ "German",
minority_language == "francaus et arabe" ~ "Arabic",
minority_language == "Bosnian (Serbian, Croatian)" ~ "Bosnian",
minority_language == "Grec" ~ "Greek",
minority_language == "Créole Reunionnais" ~ "Creole",
minority_language == "Créole reunionnais" ~ "Creole",
minority_language == "Italien" ~ "Italian",
minority_language == "Lsq" ~ "QSL",
minority_language == "LSQ" ~ "QSL",
minority_language == "Arménien" ~ "Armenian",
minority_language == "Malgache" ~ "Malagasy",
minority_language == "Cri" ~ "Cree",
TRUE ~ minority_language
)
) %>%
# Children without a language in this position don't need a row
filter(!is.na(minority_language))
language_rates <- data_clean_long %>%
select(
internal_id,
census_subdivision,
geo_uid,
language,
language_knowledge_rate
) %>%
distinct()
minority_cor_data <- minority_long %>%
left_join(
language_rates,
by = c(
"internal_id",
"census_subdivision",
"geo_uid",
"minority_language" = "language"
)
)
#Just check the participant with creole, that is the only NA that does not come from that language not existing in that census division
minority_cor_data_matrix <- minority_cor_data %>%
select(child_age_years, beleifs_ahead_in_life, beleifs_belonging, beliefs_cognitive_benefits, worry_master_languages, worry_cognitive_difficulties, worry_school_difficulties,
minority_active_use,
language_knowledge_rate,
minority_overall_exposure,
minority_book_resources,
minority_book_reading,
minority_interlocutor_matching
)
minority_cor_data_matrix <- minority_cor_data_matrix %>%
mutate(across(everything(), as.numeric))
minority_correlation <- cor(
minority_cor_data_matrix,
use = "pairwise.complete.obs",
method = "spearman"
)
corrplot(
minority_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
#Matrix with English active use (both), French, Minority. Age, exposure per language, density of speaker per language, and multilingualism rate, attitudes, and concerns (one row each).
#active use by language ~ age + language exposure + speaker rate (one set of models)
#active use by language ~ age + language exposure + speaker rate + multilingualism rate (exploratory to see if adding the multilingualism rate soaks up more variance)
extract_outcome_cor <- function(cor_matrix, outcome_var, language_group, outcome_label) {
vals <- cor_matrix[outcome_var, , drop = TRUE]
tibble(
predictor = names(vals),
correlation = as.numeric(vals),
language_group = language_group,
outcome = outcome_label
)
}
#extract active use
active_use_corrs <- bind_rows(
extract_outcome_cor(
english_correlation,
"child_english_active_use_category",
"English",
"Active language use"
),
extract_outcome_cor(
french_correlation,
"child_french_active_use_category",
"French",
"Active language use"
),
extract_outcome_cor(
minority_correlation,
"minority_active_use",
"Minority",
"Active language use"
)
)
#Extract interlocutor matching
interlocutor_corrs <- bind_rows(
extract_outcome_cor(
english_correlation,
"child_english_interlocutor_matching",
"English",
"Interlocutor matching"
),
extract_outcome_cor(
french_correlation,
"child_french_interlocutor_matching",
"French",
"Interlocutor matching"
),
extract_outcome_cor(
minority_correlation,
"minority_interlocutor_matching",
"Minority",
"Interlocutor matching"
)
)
#combine them
cor_plot_data <- bind_rows(
active_use_corrs,
interlocutor_corrs
)
#remove from predictors list
cor_plot_data <- cor_plot_data %>%
filter(
!predictor %in% c(
"child_english_active_use_category",
"child_french_active_use_category",
"minority_active_use",
"child_english_interlocutor_matching",
"child_french_interlocutor_matching",
"minority_interlocutor_matching"
)
)
#Have names match
cor_plot_data <- cor_plot_data %>%
mutate(
predictor = case_when(
predictor == "child_age_years" ~ "Child age",
predictor == "language_knowledge_rate" ~ "Speaker rate",
predictor %in% c(
"overall_exposure_english_child",
"overall_exposure_french_child",
"minority_overall_exposure"
) ~ "Overall exposure",
predictor %in% c(
"book_resources_english",
"book_resources_french",
"minority_book_resources"
) ~ "Access to books",
predictor %in% c(
"caregiver_english_book_reading",
"caregiver_french_book_reading",
"minority_book_reading"
) ~ "Book reading",
predictor == "beleifs_ahead_in_life" ~ "Status attitudes",
predictor == "beleifs_belonging" ~ "Solidarity attitudes",
predictor == "beliefs_cognitive_benefits" ~ "Cognition attitudes",
predictor == "worry_master_languages" ~ "Exposure-fluency concern",
predictor == "worry_cognitive_difficulties" ~ "Cognitive difficulties concern",
predictor == "worry_school_difficulties" ~ "School difficulties concern",
TRUE ~ predictor
)
)
#Order predictors nicely
predictor_order <- c(
"Child age",
"Speaker rate",
"Book resources",
"Overall exposure",
"Access to books",
"Status attitudes",
"Solidarity attitudes",
"Cognition attitudes",
"Exposure-fluency concern",
"Cognitive difficulties concern",
"School difficulties concern"
)
cor_plot_data <- cor_plot_data %>%
mutate(
predictor = factor(
predictor,
levels = rev(predictor_order)
)
)
#Make bubble plot
ggplot(
cor_plot_data,
aes(
x = language_group,
y = predictor,
size = abs(correlation),
fill = correlation
)
) +
geom_point(
shape = 21,
color = "black"
) +
scale_size(
range = c(2, 7),
limits = c(0, 1)
) +
scale_fill_gradient2(
low = "firebrick3",
mid = "white",
high = "steelblue4",
midpoint = 0,
limits = c(-1, 1)
) +
facet_wrap(
~ outcome,
ncol = 1
) +
labs(
x = NULL,
y = NULL,
size = "|r|",
fill = "r"
) +
theme_minimal(base_size = 14) +
theme(
panel.grid = element_blank(),
strip.text = element_text(
face = "bold",
size = 14
),
axis.text.x = element_text(
face = "bold"
),
legend.position = "right"
)
corrplot(
minority_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
corrplot(
french_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
corrplot(
english_correlation,
method = "circle",
type = "upper",
diag = TRUE,
tl.col = "black",
tl.srt = 45,
)
