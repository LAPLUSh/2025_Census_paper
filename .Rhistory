ggplot(
cor_plot_data,
aes(
x = language_group,
y = predictor,
size = abs(correlation),
fill = correlation,
shape = language_group
)
) +
geom_point(
color = "black",
stroke = 0.8
) +
# Smaller bubbles so adjacent rows don't touch
scale_size(
range = c(2, 7),
limits = c(0, 1)
) +
# Different shape for each language group
scale_shape_manual(
values = c(
"English" = 21,   # circle
"French" = 22,    # square
"Minority" = 24   # triangle
)
) +
scale_fill_gradient2(
low = "firebrick3",
mid = "white",
high = "steelblue4",
midpoint = 0,
limits = c(-1, 1)
) +
facet_wrap(
~ outcome,
ncol = 1
) +
labs(
x = NULL,
y = NULL,
size = "|r|",
fill = "r",
shape = "Language"
) +
theme_minimal(base_size = 14) +
theme(
panel.grid = element_blank(),
strip.text = element_text(
face = "bold",
size = 16
),
axis.text.x = element_text(
face = "bold",
size = 13
),
axis.text.y = element_text(
size = 12
),
legend.position = "right"
)
