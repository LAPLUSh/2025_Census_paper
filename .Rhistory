active_step3 <- compare_hierarchical_step(
outcome = "active_use",
current_predictors = c(
active_base_predictors,
"book_reading_z",
"status_attitudes_z"
),
new_predictor = "cognition_attitudes_z",
data = model_data_long
)
active_step3
# ------------------------------------------------------------
# Step 4: Add BOOK RESOURCES
# ------------------------------------------------------------
active_step4 <- compare_hierarchical_step(
outcome = "active_use",
current_predictors = c(
active_base_predictors,
"book_reading_z",
"status_attitudes_z",
"cognition_attitudes_z"
),
new_predictor = "book_resources_z",
data = model_data_long
)
active_step4
# ------------------------------------------------------------
# Step 5: Add SPEAKER RATE
# ------------------------------------------------------------
active_step5 <- compare_hierarchical_step(
outcome = "active_use",
current_predictors = c(
active_base_predictors,
"book_reading_z",
"status_attitudes_z",
"cognition_attitudes_z",
"book_resources_z"
),
new_predictor = "speaker_rate_z",
data = model_data_long
)
active_step5
# ============================================================
# 3. COMBINE ACTIVE-USE RESULTS
# ============================================================
active_hierarchy <- bind_rows(
active_step1,
active_step2,
active_step3,
active_step4,
active_step5
)
active_hierarchy
# ============================================================
# 4. INTERLOCUTOR MATCHING
# ============================================================
matching_base_predictors <- c(
"overall_exposure_z",
"child_age_years_z",
"language_type"
)
# ------------------------------------------------------------
# Step 1: Add BOOK READING
# ------------------------------------------------------------
matching_step1 <- compare_hierarchical_step(
outcome = "interlocutor_matching",
current_predictors = matching_base_predictors,
new_predictor = "book_reading_z",
data = model_data_long
)
matching_step1
# ------------------------------------------------------------
# Step 2: Add SPEAKER RATE
# ------------------------------------------------------------
matching_step2 <- compare_hierarchical_step(
outcome = "interlocutor_matching",
current_predictors = c(
matching_base_predictors,
"book_reading_z"
),
new_predictor = "speaker_rate_z",
data = model_data_long
)
matching_step2
# ------------------------------------------------------------
# Step 3: Add STATUS ATTITUDES
# ------------------------------------------------------------
matching_step3 <- compare_hierarchical_step(
outcome = "interlocutor_matching",
current_predictors = c(
matching_base_predictors,
"book_reading_z",
"speaker_rate_z"
),
new_predictor = "status_attitudes_z",
data = model_data_long
)
matching_step3
# ============================================================
# 5. COMBINE INTERLOCUTOR-MATCHING RESULTS
# ============================================================
matching_hierarchy <- bind_rows(
matching_step1,
matching_step2,
matching_step3
)
matching_hierarchy
# ============================================================
# FINAL ACTIVE-USE CANDIDATE TESTS
#
# Supported core:
# exposure + age + language type
# + book reading
# + status attitudes
# ============================================================
active_supported_predictors <- c(
"overall_exposure_z",
"child_age_years_z",
"language_type",
"book_reading_z",
"status_attitudes_z"
)
# Remaining predictors to test against supported core
active_remaining <- c(
"speaker_rate_z",
"book_resources_z",
"cognition_attitudes_z",
"exposure_fluency_concern_z",
"concern_cognitive_difficulties_z",
"concern_school_difficulties_z",
"solidarity_attitudes_z",
"number_sources_z"
)
active_final_tests <- purrr::map_dfr(
active_remaining,
function(pred) {
compare_hierarchical_step(
outcome = "active_use",
current_predictors = active_supported_predictors,
new_predictor = pred,
data = model_data_long
)
}
) %>%
arrange(delta_AIC)
# ============================================================
# FINAL INTERLOCUTOR-MATCHING CANDIDATE TESTS
#
# Supported core:
# exposure + age + language type
# + book reading
# + speaker rate
# + status attitudes
# ============================================================
matching_supported_predictors <- c(
"overall_exposure_z",
"child_age_years_z",
"language_type",
"book_reading_z",
"speaker_rate_z",
"status_attitudes_z"
)
matching_remaining <- c(
"book_resources_z",
"cognition_attitudes_z",
"solidarity_attitudes_z",
"exposure_fluency_concern_z",
"concern_cognitive_difficulties_z",
"concern_school_difficulties_z",
"number_sources_z"
)
matching_final_tests <- purrr::map_dfr(
matching_remaining,
function(pred) {
compare_hierarchical_step(
outcome = "interlocutor_matching",
current_predictors = matching_supported_predictors,
new_predictor = pred,
data = model_data_long
)
}
) %>%
arrange(delta_AIC)
# ============================================================
# FINAL MIXED-EFFECTS MODELS
# ============================================================
# ============================================================
# 1. ACTIVE LANGUAGE USE
#
# Final fixed effects:
# Exposure + Age + Language type
# + Book reading + Status attitudes
# ============================================================
active_final_data <- model_data_long %>%
drop_na(
active_use,
overall_exposure_z,
child_age_years_z,
language_type,
book_reading_z,
status_attitudes_z,
internal_id
)
active_final <- lmer(
active_use ~
overall_exposure_z +
child_age_years_z +
language_type +
book_reading_z +
status_attitudes_z +
(1 | internal_id),
data = active_final_data,
REML = TRUE
)
# Model results
summary(active_final)
# ============================================================
# 2. INTERLOCUTOR MATCHING
#
# Final fixed effects:
# Exposure + Age + Language type
# + Book reading + Speaker rate + Status attitudes
# ============================================================
matching_final_data <- model_data_long %>%
drop_na(
interlocutor_matching,
overall_exposure_z,
child_age_years_z,
language_type,
book_reading_z,
speaker_rate_z,
status_attitudes_z,
internal_id
)
matching_final <- lmer(
interlocutor_matching ~
overall_exposure_z +
child_age_years_z +
language_type +
book_reading_z +
speaker_rate_z +
status_attitudes_z +
(1 | internal_id),
data = matching_final_data,
REML = TRUE
)
# Model results
summary(matching_final)
# ============================================================
# 3. SAMPLE SIZES
# ============================================================
tibble(
Outcome = c(
"Active language use",
"Interlocutor matching"
),
Observations = c(
nrow(active_final_data),
nrow(matching_final_data)
),
Children = c(
n_distinct(active_final_data$internal_id),
n_distinct(matching_final_data$internal_id)
)
)
# ============================================================
# 4. OVERALL VARIANCE EXPLAINED
# ============================================================
# Marginal R2 = fixed effects
# Conditional R2 = fixed + random effects
performance::r2(active_final)
performance::r2(matching_final)
# ============================================================
# 5. ICC
#
# Proportion of residual variance attributable to
# differences between children
# ============================================================
performance::icc(active_final)
performance::icc(matching_final)
# ============================================================
# 6. MODEL DIAGNOSTICS
# ============================================================
performance::check_singularity(active_final)
performance::check_singularity(matching_final)
performance::check_model(active_final)
model_table
models <- list(
"Active language use" = active_final,
"Interlocutor matching" = matching_final
)
# Rename coefficients for readability
coef_names <- c(
"(Intercept)" = "Intercept",
"overall_exposure_z" = "Overall language exposure",
"child_age_years_z" = "Child age",
"language_typeFrench" = "Language: French (vs. English)",
"language_typeMinority" = "Language: Minority (vs. English)",
"book_reading_z" = "Book reading",
"speaker_rate_z" = "Community speaker rate",
"status_attitudes_z" = "Status attitudes"
)
# Create table
model_table <- modelsummary(
models,
coef_map = coef_names,
# Estimate and standard error on first line;
# p-value on second line
estimate = "{estimate} ({std.error})",
statistic = "p = {p.value}",
fmt = 3,
# Display selected model information
gof_map = c(
"nobs",
"AIC",
"BIC"
),
stars = FALSE,
output = "flextable"
)
