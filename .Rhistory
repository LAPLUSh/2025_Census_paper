census_clean$submitted_date<- as.Date(census_clean$submitted_date)
census_clean$dob <- as.Date(census_clean$dob)
census_clean$child_age_years <- time_length(
interval(census_clean$dob, census_clean$submitted_date),
unit = "years"
) |> floor()
df_base<- census_clean %>%
select(internal_id, status, child_age_years, child_gender, other_caregiver, child_speaks_minority_languages, vision_hearing_delays, school_daycare_attendance, school_language, daycare_language, where_do_you_live, child_english, c1_english_percent, c2_english_percent, child_french, c1_french_percent, c2_french_percent, first_minority_language, c1_first_minority_percent, c2_first_minority_percent, second_minority_language,c1_second_minority_percent, c2_second_minority_percent, third_minority_language, c1_third_minority_percent, c2_third_minority_percent) %>%
filter(status == "Submitted", vision_hearing_delays !="Yes"|is.na(vision_hearing_delays))
View(df_base)
