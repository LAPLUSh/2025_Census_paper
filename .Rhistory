extract_outcome_cor <- function(cor_matrix, outcome_var, language_group, outcome_label) {
vals <- cor_matrix[outcome_var, , drop = TRUE]
tibble(
predictor = names(vals),
correlation = as.numeric(vals),
language_group = language_group,
outcome = outcome_label
)
}
#extract active use
active_use_corrs <- bind_rows(
extract_outcome_cor(
english_correlation,
"child_english_active_use_category",
"English",
"Active language use"
),
extract_outcome_cor(
french_correlation,
"child_french_active_use_category",
"French",
"Active language use"
),
extract_outcome_cor(
minority_correlation,
"minority_active_use",
"Minority",
"Active language use"
)
)
#Extract interlocutor matching
interlocutor_corrs <- bind_rows(
extract_outcome_cor(
english_correlation,
"child_english_interlocutor_matching",
"English",
"Interlocutor matching"
),
extract_outcome_cor(
french_correlation,
"child_french_interlocutor_matching",
"French",
"Interlocutor matching"
),
extract_outcome_cor(
minority_correlation,
"minority_interlocutor_matching",
"Minority",
"Interlocutor matching"
)
)
#combine them
cor_plot_data <- bind_rows(
active_use_corrs,
interlocutor_corrs
)
#remove from predictors list
cor_plot_data <- cor_plot_data %>%
filter(
!predictor %in% c(
"child_english_active_use_category",
"child_french_active_use_category",
"minority_active_use",
"child_english_interlocutor_matching",
"child_french_interlocutor_matching",
"minority_interlocutor_matching"
)
)
#Have names match
cor_plot_data <- cor_plot_data %>%
mutate(
predictor = case_when(
predictor == "child_age_years" ~ "Child age",
predictor == "language_knowledge_rate" ~ "Speaker rate",
predictor %in% c(
"overall_exposure_english_child",
"overall_exposure_french_child",
"minority_overall_exposure"
) ~ "Overall exposure",
predictor %in% c(
"book_resources_english",
"book_resources_french",
"minority_book_resources"
) ~ "Book resources",
predictor %in% c(
"caregiver_english_book_reading",
"caregiver_french_book_reading",
"minority_book_reading"
) ~ "Book reading",
predictor == "beleifs_ahead_in_life" ~ "Ahead in life",
predictor == "beleifs_belonging" ~ "Belonging",
predictor == "beliefs_cognitive_benefits" ~ "Cognitive benefits",
predictor == "worry_master_languages" ~ "Mastering languages",
predictor == "worry_cognitive_difficulties" ~ "Cognitive difficulties",
predictor == "worry_school_difficulties" ~ "School difficulties",
TRUE ~ predictor
)
)
#Order predictors nicely
predictor_order <- c(
"Child age",
"Speaker rate",
"Overall exposure",
"Book resources",
"Book reading",
"Ahead in life",
"Belonging",
"Cognitive benefits",
"Mastering languages",
"Cognitive difficulties",
"School difficulties"
)
cor_plot_data <- cor_plot_data %>%
mutate(
predictor = factor(
predictor,
levels = rev(predictor_order)
)
)
#Make bubble plot
ggplot(
cor_plot_data,
aes(
x = language_group,
y = predictor,
size = abs(correlation),
fill = correlation
)
) +
geom_point(
shape = 21,
color = "black"
) +
scale_size(
range = c(2, 10),
limits = c(0, 1)
) +
scale_fill_gradient2(
low = "firebrick3",
mid = "white",
high = "steelblue4",
midpoint = 0,
limits = c(-1, 1)
) +
facet_wrap(
~ outcome,
ncol = 1
) +
labs(
x = NULL,
y = NULL,
size = "|r|",
fill = "r"
) +
theme_minimal(base_size = 14) +
theme(
panel.grid = element_blank(),
strip.text = element_text(
face = "bold",
size = 14
),
axis.text.x = element_text(
face = "bold"
),
legend.position = "right"
)
