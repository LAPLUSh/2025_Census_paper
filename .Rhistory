breaks = seq(0, 100, 20),
labels = function(x) paste0(x, "%")
) +
labs(
x = NULL,
y = "Languages below activeness threshold (%)",
fill = "Language type",
title = "Which languages fall below the activeness threshold?"
) +
theme_classic(base_size = 14) +
theme(
axis.text.x = element_text(
angle = 15,
hjust = 1
),
legend.position = "bottom"
)
inactive_figure
