Minority Language Analyses
```{r first minority language analyses, include = FALSE}

#First let's create an anchor data frame that has just the columns we need and excludes participants based on our criteria. We can then use this anchor to add wrangled predictors

first_minority_anchor_analysis_df<- triquest_clean %>%
  select(internal_id, status, child_age_years, child_gender, other_caregiver, child_speaks_minority_languages, premature, vision_hearing_delays, school_daycare_attendance, school_language, daycare_language, first_minority_language, c1_first_minority_percent, c2_first_minority_percent) %>%
  filter(status == "Submitted", vision_hearing_delays !="Yes"|is.na(vision_hearing_delays), !is.na(child_speaks_minority_languages))



first_minority_anchor_analysis_df <- first_minority_anchor_analysis_df %>%
  #Identifying which caregivers speak the minority language
  mutate(caregiver_source_number = case_when(c1_first_minority_percent >=25 & c2_first_minority_percent>=25 ~ 2,
                                             c1_first_minority_percent>=25| c2_first_minority_percent>=25 ~ 1,
                                             TRUE~ 0),
         school_language_source = case_when(str_detect(tolower(school_language), "other") ~ 1L,
      TRUE ~ 0L),
      
      overall_sources = caregiver_source_number + school_language_source
         
         ) %>%
  #making a binary variable with school entry 
  mutate(started_school = case_when(school_daycare_attendance == "School"~1L,
                                    TRUE~ 0L))





#First let's wrangle our active use outcome variables, and later add them to our anchor df

minority_active_use<- triquest_clean %>% 
  select(internal_id, child_first_minority_active_category,  child_first_minority_active_use_percent) %>%
  mutate(child_first_minority_active_coded = case_when(child_first_minority_active_category == "My child speaks this language spontaneously" ~3,
                                                       child_first_minority_active_category == "My child speaks this language mainly when someone addresses them in that language"~2,
                                                       child_first_minority_active_category=="My child understands this language, but rarely speaks in it"~ 1, 
                                                       TRUE~ 0)) %>%
  select(-child_first_minority_active_category)



for_minority_analyses<- first_minority_anchor_analysis_df %>%
  left_join(minority_active_use)


#Now let's wrangle the data to obtain the predictors that are missing (language exposure, explicit adoption of a strategy, and home literacy)

minority_all_predictors<- triquest_clean %>% 
  select(internal_id, overall_exposure_first_minority,two_caregiver_explicit_strategy, single_parent_explicit_strategy,  percentage_books_first_minority, num_bilingual_books_eng_minority, num_bilingual_books_eng_french, num_bilingual_books_fre_minority, num_bilingual_books_two_minority, frequency_reading_only_first_minority, frequency_bilingual_books_first_minority) %>%
  mutate(explicit_strategy_use = case_when(two_caregiver_explicit_strategy == "I and my child's other primary caregiver both follow a strategy."~ 2,
                                           two_caregiver_explicit_strategy == " My child's primary caregiver follows a strategy, but I do not."| two_caregiver_explicit_strategy == "I follow a strategy, but my child's other primary caregiver does not."|single_parent_explicit_strategy=="Yes, I do."~1,
TRUE~0 ))


for_minority_analyses<- for_minority_analyses %>%
  left_join(minority_all_predictors) 


#-------- Active use graphs -----------#

min_cat_use<- for_minority_analyses %>%
  select(child_first_minority_active_coded) %>%
  mutate(categorical_active_use = case_when(child_first_minority_active_coded == 3~ "Spontaneous use",
                                            child_first_minority_active_coded == 2~ "Only when addressed",
                                            child_first_minority_active_coded == 1~ "Understands.Rarely speaks",
                                            TRUE~ "Never")) %>%
  select(-child_first_minority_active_coded) %>%
  count(categorical_active_use) %>%
  arrange(factor(
    categorical_active_use,
    levels = c(
      "Spontaneous use",
      "Only when addressed",
       "Understands.Rarely speaks"
    )
  )) %>%
  mutate(
    prop = n / sum(n),
    ypos = cumsum(prop) - 0.5 * prop
  )


disc_min_active<- ggplot(data= min_cat_use,
       aes(x = 2, y = prop, fill = categorical_active_use)) +
  geom_col(width = 1, color = "white") +
  coord_polar(theta = "y") +
  xlim(0.5, 2.5) + # controls hole size
 scale_fill_manual(values=c("#fae0bd", "#b0da87", "#8daee1"))+
   theme_void() +
  labs(
    title = "Heritage Language Active Use Distribution",
    fill = NULL
  )

hist_min_active<- ggplot(data = for_minority_analyses, aes(x=child_first_minority_active_use_percent)) +
  geom_histogram()+
  labs(title="Percentage Active Use Distribution")+
  theme_minimal()


minimal_active_use_plots <- disc_min_active + hist_min_active +
