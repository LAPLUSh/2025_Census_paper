#Making a table to describe the predictors


heritage_descriptives_table <- for_minority_analyses %>%
  select(percentage_books_first_minority, num_bilingual_books_eng_minority, num_bilingual_books_eng_french, num_bilingual_books_fre_minority, num_bilingual_books_two_minority, frequency_reading_only_first_minority, frequency_bilingual_books_first_minority, explicit_strategy_use, overall_exposure_first_minority, child_first_minority_active_use_percent) %>%   # choose columns
  pivot_longer(
    cols = everything(),
    names_to = "Variable",
    values_to = "Value"
  ) %>%
  group_by(Variable) %>%
  summarise(
    Mean  = mean(Value, na.rm = TRUE),
    Min   = min(Value, na.rm = TRUE),
    Max   = max(Value, na.rm = TRUE),
    Range = paste0(Min, "–", Max),
    .groups = "drop"
  ) %>%
  select(Variable, Mean, Range)



#--------- Correlation analyses-----------#


